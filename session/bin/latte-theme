#!/usr/bin/env bash
# latte-theme — témy LatteOS (session/themes, inspo návrh: „témy materiálov“, „drahokamy a klasické“).
#   latte-theme list          zoznam tém
#   latte-theme current       aktuálna téma
#   latte-theme set <id>      prepne tému: paleta a režim Noctalie, tapeta, okraje okien Hyprlandu
#   latte-theme workspace <n>  tapeta podľa plochy: n-tá tapeta z /usr/share/backgrounds/latteos (ak je zapnuté)
#   latte-theme mode [tema|dark|light|auto]
#                             svetlá/tmavá verzia: podľa témy, vždy tmavá, vždy svetlá, alebo automaticky
#                             podľa východu a západu slnka (poloha: Nastavenia › Systém › Dátum a čas)
# Voľba sa ukladá do ~/.config/latteos/theme; Lua modul Hyprlandu si z nej berie farby a efekty.
set -u
dir=/usr/share/latteos/themes
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/latteos"
get() { sed -n "s/^$2 = //p" "$dir/$1.theme"; }
current() { cat "$cfg/theme" 2>/dev/null || echo latte; }
modepref() { cat "$cfg/theme-mode" 2>/dev/null || echo tema; }
# režim pre Noctaliu: voľba používateľa, inak režim z témy
effmode() { m="$(modepref)"; [ "$m" = tema ] && m="$(get "$1" mode)"; echo "$m"; }

case "${1:-list}" in
list)
    for f in "$dir"/*.theme; do
        id="$(basename "$f" .theme)"
        mark=" "; [ "$id" = "$(current)" ] && mark="*"
        printf '%s %-11s %-24s %s\n' "$mark" "$id" "$(get "$id" name)" "$(get "$id" desc)"
    done ;;
current)
    current ;;
set)
    id="${2:?použitie: latte-theme set <id>}"
    [ -f "$dir/$id.theme" ] || { echo "neznáma téma: $id (latte-theme list)"; exit 1; }
    mkdir -p "$cfg" && printf '%s\n' "$id" > "$cfg/theme"
    noctalia msg color-scheme-set custom "$(get "$id" palette)" >/dev/null 2>&1
    noctalia msg theme-mode-set "$(effmode "$id")" >/dev/null 2>&1
    wp="$(get "$id" wallpaper)"
    [ -n "$wp" ] && noctalia msg wallpaper-set "/usr/share/backgrounds/latteos/$wp" >/dev/null 2>&1
    [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl reload >/dev/null 2>&1
    notify-send -a LatteOS "Téma" "$(get "$id" name)" 2>/dev/null
    echo "téma: $(get "$id" name)" ;;
workspace)
    [ -e "$cfg/wallpaper-per-workspace" ] || exit 0
    n="${2:-1}"; case "$n" in ''|*[!0-9]*) exit 2 ;; esac
    set -- /usr/share/backgrounds/latteos/*
    [ $# -gt 0 ] || exit 0
    i=$(( (n - 1) % $# + 1 )); eval "wp=\${$i}"
    noctalia msg wallpaper-set "$wp" >/dev/null 2>&1 ;;
mode)
    [ -z "${2:-}" ] && { modepref; exit 0; }
    case "$2" in tema|dark|light|auto) ;; *) echo "režim: tema | dark | light | auto"; exit 2 ;; esac
    mkdir -p "$cfg" && printf '%s\n' "$2" > "$cfg/theme-mode"
    noctalia msg theme-mode-set "$(effmode "$(current)")" >/dev/null 2>&1
    echo "režim: $2" ;;
*)
    echo "použitie: latte-theme list | current | set <id> | mode [tema|dark|light|auto]"; exit 2 ;;
esac
