#!/usr/bin/python3
"""latte-kopia — kopírovanie a presun pre Súbory (F5 / F6 ako Total Commander), s priebehom po bajtoch.

  latte-kopia konflikty CIEĽ ZDROJ…                    vypíše mená, ktoré už v cieli existujú (riadok = meno)
  latte-kopia kopiruj|presun [--rezim R] [--maska M] [--overit] [--limit MB/s] CIEĽ ZDROJ…

Režim pri existujúcom súbore (--rezim): prepisat · preskocit · starsie (prepíše iba staršie) · premenovat („meno (2).ext“).
Maska (--maska): „*.jpg;*.png“ — kopírujú sa iba súbory, ktoré jej vyhovujú (priečinky sa prechádzajú).
CIEĽ končiaci „/“ alebo existujúci priečinok = kopírovať do neho; inak pri jednom zdroji = nové meno (premenovanie).
Výstup (riadky): „P percent skopírované spolu aktuálne_meno“, „E chyba“, na konci „OK súborov preskočených“.
Presun v rámci jedného disku je okamžitý (rename); medzi diskami kópia + zmazanie. --overit porovná obsah (SHA-256).
--limit obmedzí rýchlosť kopírovania (MB/s, ako v Total Commanderi), napr. aby USB disk alebo sieť ostali použiteľné.
"""
import fnmatch, hashlib, os, shutil, stat, sys, time

CHUNK = 1 << 20
last = 0.0


def out(*a):
    print(*a, flush=True)


def matches(name, masks):
    return not masks or any(fnmatch.fnmatch(name.lower(), m.lower()) for m in masks)


def walk(src, masks):
    """(zdrojový súbor, relatívna cesta, veľkosť) pre všetky súbory; priečinky ako (cesta, rel, -1)."""
    base = os.path.dirname(src.rstrip("/"))
    if os.path.isdir(src) and not os.path.islink(src):
        for root, dirs, files in os.walk(src):
            rel = os.path.relpath(root, base)
            yield root, rel, -1
            for f in sorted(files):
                p = os.path.join(root, f)
                if matches(f, masks):
                    try:
                        yield p, os.path.join(rel, f), os.lstat(p).st_size
                    except OSError:
                        pass
    elif matches(os.path.basename(src), masks):
        yield src, os.path.basename(src), os.lstat(src).st_size


def free_name(p):
    stem, ext = os.path.splitext(p)
    i = 2
    while os.path.lexists("%s (%d)%s" % (stem, i, ext)):
        i += 1
    return "%s (%d)%s" % (stem, i, ext)


def sha(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(CHUNK), b""):
            h.update(b)
    return h.hexdigest()


def main(a):
    global last
    if len(a) >= 3 and a[0] == "konflikty":
        dst = a[1]
        for s in a[2:]:
            n = os.path.basename(s.rstrip("/"))
            if os.path.lexists(os.path.join(dst, n)):
                print(n)
        return 0
    if not a or a[0] not in ("kopiruj", "presun"):
        print(__doc__, file=sys.stderr)
        return 2
    move = a[0] == "presun"
    mode, masks, verify, limit = "preskocit", [], False, 0.0
    rest = a[1:]
    while rest and rest[0].startswith("--"):
        o = rest.pop(0)
        if o == "--rezim":
            mode = rest.pop(0)
        elif o == "--maska":
            masks = [m for m in rest.pop(0).replace(",", ";").split(";") if m.strip() and m.strip() not in ("*", "*.*")]
        elif o == "--overit":
            verify = True
        elif o == "--limit":
            try:
                limit = max(0.0, float(rest.pop(0))) * 1024 * 1024
            except ValueError:
                limit = 0.0
    if len(rest) < 2:
        return 2
    dst, srcs = rest[0], rest[1:]
    into = dst.endswith("/") or os.path.isdir(dst) or len(srcs) > 1
    dst = dst.rstrip("/") or "/"
    if into:
        os.makedirs(dst, exist_ok=True)
    # plán a celková veľkosť
    plan, renamed = [], 0
    for s in srcs:
        s = s.rstrip("/") or "/"
        if not os.path.lexists(s):
            out("E", "nenájdené:", s)
            continue
        if into and os.path.abspath(dst).startswith(os.path.abspath(s) + "/"):
            out("E", "priečinok nejde kopírovať sám do seba:", s)
            continue
        # rýchly presun v rámci disku
        if move and not masks:
            target = os.path.join(dst, os.path.basename(s)) if into else dst
            try:
                if os.stat(s).st_dev == os.stat(os.path.dirname(target) or "/").st_dev:
                    if os.path.lexists(target):
                        if mode == "preskocit" or (mode == "starsie" and os.path.getmtime(target) >= os.path.getmtime(s)):
                            continue
                        if mode == "premenovat":
                            target = free_name(target)
                        elif os.path.isdir(target) and not os.path.islink(target):
                            pass                          # zlúčiť priečinky → cez kópiu nižšie
                        else:
                            os.remove(target)
                    if not os.path.lexists(target):
                        os.rename(s, target)
                        renamed += 1
                        continue
            except OSError as e:
                out("E", str(e))
                continue
        for p, rel, size in walk(s, masks):
            if not into:
                rel = os.path.join(os.path.basename(dst), os.path.relpath(p, s)) if os.path.isdir(s) else os.path.basename(dst)
                t = os.path.join(os.path.dirname(dst), rel)
            else:
                t = os.path.join(dst, rel)
            plan.append((p, t, size, s))
    total = sum(max(0, x[2]) for x in plan) or 1
    done, copied, skipped = 0, 0, 0
    t0, sent = time.monotonic(), 0
    for p, t, size, root in plan:
        try:
            if size < 0:
                os.makedirs(t, exist_ok=True)
                continue
            if os.path.lexists(t):
                if mode == "preskocit" or (mode == "starsie" and os.path.getmtime(t) >= os.path.getmtime(p)):
                    skipped += 1; done += size; continue
                if mode == "premenovat":
                    t = free_name(t)
            os.makedirs(os.path.dirname(t), exist_ok=True)
            if os.path.islink(p):
                if os.path.lexists(t):
                    os.remove(t)
                os.symlink(os.readlink(p), t)
            else:
                with open(p, "rb") as fi, open(t + ".latte-part", "wb") as fo:
                    while True:
                        b = fi.read(CHUNK)
                        if not b:
                            break
                        fo.write(b); done += len(b); sent += len(b)
                        if limit:                                   # obmedzenie rýchlosti: počkať, kým čas dobehne bajty
                            ahead = sent / limit - (time.monotonic() - t0)
                            if ahead > 0:
                                time.sleep(ahead)
                        now = time.monotonic()
                        if now - last > 0.2:
                            last = now
                            out("P", int(100 * done / total), done, total, os.path.basename(p))
                os.replace(t + ".latte-part", t)
                shutil.copystat(p, t, follow_symlinks=False)
                if verify and sha(p) != sha(t):
                    out("E", "overenie zlyhalo:", t); continue
            copied += 1
        except OSError as e:
            out("E", str(e))
            try:
                os.remove(t + ".latte-part")
            except OSError:
                pass
    if move:                                        # zmazať zdroje, ktoré sa celé skopírovali
        for s in srcs:
            s = s.rstrip("/")
            if not os.path.lexists(s):
                continue
            try:
                if os.path.isdir(s) and not os.path.islink(s):
                    if not masks and not skipped:
                        shutil.rmtree(s)
                    else:                           # s maskou / preskočenými: zmazať iba prenesené súbory
                        for p, t, size, root in plan:
                            if root == s and size >= 0 and os.path.exists(t) and os.path.exists(p) and os.path.getsize(t) == size:
                                os.remove(p)
                elif not skipped or masks:
                    os.remove(s)
            except OSError as e:
                out("E", str(e))
    out("P", 100, total, total, "")
    out("OK", copied + renamed, skipped)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
