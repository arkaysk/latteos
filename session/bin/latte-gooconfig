#!/usr/bin/env python3
"""latte-gooconfig — jeden dokument profilu používateľa LatteOS GOO: ~/.config/latteos/<účet>@gooconfig.json.

V ňom je celé prostredie účtu: ktoré goo sú zapnuté a kde sedia, ich vzhľad (káva), vzhľad okien (téma), tapeta,
obrazovky, widgety Noctalie, spúšťač… — to, čo je inak rozsypané v ~/.config/latteos a ~/.local/state/latteos.
Každý účet má svoj dokument (vo svojom domove), takže každý má GooPower inde, iné goo aj inú tapetu.

  latte-gooconfig cesta             kde dokument je
  latte-gooconfig ukaz              čo v ňom je (stručne)
  latte-gooconfig zber              zapíše do dokumentu, čo sa v nastaveniach zmenilo
  latte-gooconfig pouzi [SÚBOR] [--hned]   rozloží dokument (alebo iný, napr. prenesený z iného počítača) do nastavení;
                                    --hned: bežiace kvapky, tapeta a téma zmenu prevezmú okamžite
  latte-gooconfig export SÚBOR      kópia dokumentu
  latte-gooconfig prihlasenie       pri štarte relácie: dokument zmenený mimo LatteOS sa použije, inak sa doplní
  latte-gooconfig sleduj            beží s plochou: zmena nastavení → dokument, zmena dokumentu → nastavenia

Stav (prvá verzia, 6. 10. 2026): programy LatteOS ešte čítajú svoje pôvodné súbory; dokument s nimi tento nástroj
drží v zhode OBOMA smermi. Kto dokument upraví ručne alebo si ho prinesie, tomu sa pri prihlásení (alebo hneď, kým
beží `sleduj`) rozloží do nastavení. Postupne ho programy budú čítať priamo (session/goo/README.md › Profil).

Tajomstvá v dokumente nie sú: kľúče s menom ako key / token / secret / password sa vynechajú. Dokument má práva 600.
Prihlasovanie (iný účet, do domova nevidí) dostane iba výťah: kde sedí GooPower a aká je káva
(/var/lib/latteos/greeter/goo-<účet>.json).
"""
import hashlib, json, os, pwd, re, sys, time

HOME = os.path.expanduser("~")
LOGIN = pwd.getpwuid(os.getuid()).pw_name
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "latteos")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "latteos")
DOC = os.path.join(CONF, "%s@gooconfig.json" % LOGIN)
MARK = os.path.join(STATE, "gooconfig.odtlacok")          # odtlačok dokumentu, ako ho naposledy zapísal tento nástroj
GREETER = "/var/lib/latteos/greeter"
VERZIA = 1
TAJNE = re.compile(r"key|token|secret|passw|heslo", re.I)

# (cesta v dokumente, súbor, druh): json = obsah ako objekt, text = ako text, riadok = prvý riadok (jedno slovo),
# priecinok = všetky *.json v priečinku ako { meno: objekt }, toml = text bez tajných kľúčov
MAPA = [
    ("goo.kvapky",          STATE + "/goo/stav.json",                    "json"),      # kde ktorá kvapka sedí a aká je veľká
    ("goo.nastavenia",      CONF + "/kvapky.json",                       "json"),      # skryté, veľkosti, vlastné
    ("goo.vlastne",         CONF + "/goo/kvapky",                        "priecinok"), # kvapky používateľa (JSON)
    ("goo.kava",            CONF + "/kava",                              "riadok"),    # vzhľad goo: pomer vody a mlieka
    ("goo.pas_vykonu",      STATE + "/goo/pas",                          "riadok"),
    ("okna.tema",           CONF + "/theme",                             "riadok"),    # vzhľad okien
    ("okna.rezim",          CONF + "/theme-mode",                        "riadok"),
    ("okna.vykon",          CONF + "/tier",                              "riadok"),
    ("tapeta.nastavenie",   CONF + "/tapety.json",                       "json"),
    ("tapeta.ziva",         CONF + "/live-wallpaper",                    "riadok"),
    ("obrazovky",           CONF + "/monitors.lua",                      "text"),
    ("noctalia.widgety",    CONF + "/kvapky-widgety.json",               "json"),      # widgety rohovej lišty
    ("noctalia.nastavenia", STATE + "/kvapky/noctalia/settings.toml",    "text"),
    ("spustac",             CONF + "/spustac.json",                      "json"),
    ("subory",              CONF + "/subory.json",                       "json"),
    ("maskot.druh",         CONF + "/mascot",                            "riadok"),
    ("maskot.rezim",        CONF + "/mascot-mode",                       "riadok"),
    ("ai",                  CONF + "/ai.toml",                           "toml"),
    ("siet.bez_internetu",  CONF + "/net-vypnute",                       "text"),
    ("jazyk",               CONF + "/locale",                            "text"),
    ("slovnik",             CONF + "/slovnik.dic",                       "text"),
]


def citaj(path, kind):
    try:
        if kind == "priecinok":
            out = {}
            for f in sorted(os.listdir(path)):
                if f.endswith(".json"):
                    try:
                        out[f[:-5]] = json.load(open(os.path.join(path, f), encoding="utf-8"))
                    except (OSError, ValueError):
                        pass
            return out or None
        raw = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    if kind == "json":
        try:
            return json.loads(raw)
        except ValueError:
            return None
    if kind == "riadok":
        return raw.strip().splitlines()[0].strip() if raw.strip() else ""
    if kind == "toml":
        return "\n".join(l for l in raw.splitlines() if not TAJNE.search(l.split("=")[0])) + "\n"
    return raw


def zapis(path, kind, v):
    """rozloží hodnotu z dokumentu do súboru nastavení; vráti True, ak sa súbor zmenil"""
    if v is None:
        return False
    if kind == "priecinok":
        if not isinstance(v, dict):
            return False
        zmena = False
        os.makedirs(path, exist_ok=True)
        for name, obj in v.items():
            if re.fullmatch(r"[\w.-]{1,64}", name):
                zmena |= zapis(os.path.join(path, name + ".json"), "json", obj)
        return zmena
    if kind == "json":
        text = json.dumps(v, ensure_ascii=False, indent=1) + "\n"
        try:
            if json.load(open(path, encoding="utf-8")) == v:
                return False
        except (OSError, ValueError):
            pass
    elif kind == "riadok":
        text = str(v).strip() + "\n"
        if citaj(path, kind) == str(v).strip():
            return False
    else:
        text = str(v)
        if kind == "toml":                                # tajné kľúče v súbore ostávajú (v dokumente nie sú)
            try:
                keep = [l for l in open(path, encoding="utf-8").read().splitlines() if TAJNE.search(l.split("=")[0])]
            except OSError:
                keep = []
            if keep:
                text = text.rstrip("\n") + "\n" + "\n".join(keep) + "\n"
        try:
            if open(path, encoding="utf-8", errors="replace").read() == text:
                return False
        except OSError:
            pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".latte-new", "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(path + ".latte-new", path)
    return True


def get(d, dotted):
    for k in dotted.split("."):
        if not isinstance(d, dict) or k not in d:
            return None
        d = d[k]
    return d


def put(d, dotted, v):
    ks = dotted.split(".")
    for k in ks[:-1]:
        d = d.setdefault(k, {})
    d[ks[-1]] = v


def nacitaj(path=DOC):
    try:
        d = json.load(open(path, encoding="utf-8"))
        return d if isinstance(d, dict) else None
    except (OSError, ValueError):
        return None


def odtlacok(path=DOC):
    try:
        return hashlib.sha256(open(path, "rb").read()).hexdigest()
    except OSError:
        return ""


def zmeneny_zvonka():
    """dokument na disku nie je ten, ktorý tento nástroj naposledy zapísal (ručná úprava, prenos z iného počítača)"""
    now = odtlacok()
    if not now:
        return False
    try:
        return open(MARK).read().strip() != now
    except OSError:
        return nacitaj() is not None                      # dokument tu je, ale nikdy sme ho nepísali: je prinesený


def poznac():
    os.makedirs(STATE, exist_ok=True)
    with open(MARK, "w") as f:
        f.write(odtlacok() + "\n")


def vytah(doc):
    """výťah pre prihlasovanie (iný účet): kde sedí GooPower a aká je káva — nič osobné"""
    try:
        if not os.access(GREETER, os.W_OK):
            return
        x = (get(doc, "goo.kvapky") or {}).get("goopower", {}).get("x")
        out = {"kava": get(doc, "goo.kava") or ""}
        if isinstance(x, (int, float)):
            out["goopower"] = x
        p = os.path.join(GREETER, "goo-%s.json" % LOGIN)
        with open(p + ".new", "w") as f:
            json.dump(out, f)
        os.replace(p + ".new", p)
    except (OSError, AttributeError):
        pass


def zber(quiet=False):
    old = nacitaj() or {}
    doc = {"gooconfig": VERZIA, "ucet": {"login": LOGIN, "meno": pwd.getpwnam(LOGIN).pw_gecos.split(",")[0].strip() or LOGIN}}
    for dotted, path, kind in MAPA:
        v = citaj(path, kind)
        if v is None:
            v = get(old, dotted)                          # súbor (ešte) nie je: čo bolo v dokumente, ostáva
        if v is not None:
            put(doc, dotted, v)
    for k, v in old.items():                              # čo tento nástroj nepozná (novšia verzia, vlastné poznámky), nezahodí
        doc.setdefault(k, v)
    bez = lambda d: {k: v for k, v in d.items() if k != "upravene"}
    if bez(doc) == bez(old) and os.path.exists(DOC):
        if not os.path.exists(MARK):
            poznac()
        return False
    doc["upravene"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    os.makedirs(CONF, exist_ok=True)
    fd = os.open(DOC + ".latte-new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, indent=1)
        f.write("\n")
    os.replace(DOC + ".latte-new", DOC)
    poznac()
    vytah(doc)
    if not quiet:
        print("dokument doplnený: " + DOC)
    return True


def obnov(zmenene, doc):
    """čo práve beží, prevezme zmenu hneď (engine Goo, tapeta, téma); inak sa prejaví pri prihlásení"""
    import subprocess
    ticho = dict(stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if not os.environ.get("WAYLAND_DISPLAY"):
        return
    # engine Goo tohto účtu: iba proces s menom pleamar a scénou goo.plm (nie hocičo, čo má ten text v príkaze)
    moje = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if os.stat("/proc/" + pid).st_uid != os.getuid() or open("/proc/%s/comm" % pid).read().strip() != "pleamar":
                continue
            if "/goo.plm" in open("/proc/%s/cmdline" % pid).read().replace("\0", " "):
                moje.append(int(pid))
        except OSError:
            continue
    if moje and any(z.startswith("goo.") and z != "goo.nastavenia" for z in zmenene):
        import signal
        for pid in moje:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        subprocess.Popen(["sh", "-c", "sleep 0.8; latte-kvapky start"], **ticho)
    if "okna.tema" in zmenene and get(doc, "okna.tema"):
        subprocess.Popen(["latte-theme", "set", str(get(doc, "okna.tema"))], **ticho)
    elif "okna.rezim" in zmenene and get(doc, "okna.rezim"):
        subprocess.Popen(["latte-theme", "mode", str(get(doc, "okna.rezim"))], **ticho)
    if any(z.startswith("tapeta.") for z in zmenene):
        subprocess.Popen(["latte-tapety", "obnov", "--bez-shellu"], **ticho)


def pouzi(path=DOC, quiet=False, hned=False):
    doc = nacitaj(path)
    if doc is None:
        print("dokument sa nedá prečítať: " + path, file=sys.stderr)
        return None
    if not isinstance(doc.get("gooconfig"), int) or doc["gooconfig"] > VERZIA:
        print("dokument je z novšej verzie LatteOS (gooconfig %s), nepoužijem ho" % doc.get("gooconfig"), file=sys.stderr)
        return None
    zmenene = [dotted for dotted, p, kind in MAPA if zapis(p, kind, get(doc, dotted))]
    if os.path.realpath(path) != os.path.realpath(DOC):
        zber(quiet=True)                                  # prinesený dokument sa stane dokumentom účtu
    else:
        poznac()
        vytah(doc)
    if hned and zmenene:
        obnov(zmenene, doc)
    if not quiet:
        print(("použité: " + ", ".join(zmenene)) if zmenene else "nastavenia už zodpovedajú dokumentu")
    return zmenene


def mtimes():
    out = {}
    for _, p, kind in MAPA:
        try:
            if kind == "priecinok":
                out[p] = max([os.path.getmtime(p)] + [os.path.getmtime(os.path.join(p, f)) for f in os.listdir(p)])
            else:
                out[p] = os.path.getmtime(p)
        except OSError:
            out[p] = 0
    return out


def sleduj():
    """beží s plochou: zmenu nastavení zapíše do dokumentu (po chvíli pokoja), ručne zmenený dokument rozloží"""
    if zmeneny_zvonka():
        pouzi(quiet=True)
    zber(quiet=True)
    last, dirty = mtimes(), 0.0
    while True:
        time.sleep(2)
        if zmeneny_zvonka():
            zm = pouzi(quiet=True, hned=True)
            if zm:
                print("dokument zmenený mimo LatteOS → použité: " + ", ".join(zm), flush=True)
            last = mtimes()
            continue
        now = mtimes()
        if now != last:
            last, dirty = now, time.time()
        if dirty and time.time() - dirty >= 3:            # kvapka sa práve ťahá, nastavenie sa práve mení: počkať
            dirty = 0.0
            zber(quiet=True)


def ukaz():
    d = nacitaj()
    if d is None:
        print("dokument ešte nie je (latte-gooconfig zber): " + DOC)
        return 1
    kv = get(d, "goo.kvapky") or {}
    ns = get(d, "goo.nastavenia") or {}
    print(DOC)
    print("  účet        %s (%s) · upravené %s" % (get(d, "ucet.meno"), get(d, "ucet.login"), d.get("upravene", "?")))
    print("  goo         %d kvapiek s uloženým miestom · skryté: %s · káva: %s" % (
        len(kv), ", ".join(ns.get("skryte") or []) or "žiadne", get(d, "goo.kava") or "espresso"))
    gp = kv.get("goopower") or {}
    if gp:
        print("  GooPower    %.0f %% šírky, veľkosť %.0f %%" % (100 * gp.get("x", 0), 100 * gp.get("z", 1)))
    print("  okná        téma %s (%s), výkon %s" % (get(d, "okna.tema"), get(d, "okna.rezim"), get(d, "okna.vykon")))
    t = (get(d, "tapeta.nastavenie") or {}).get("vystupy", {})
    print("  tapeta      " + ", ".join("%s: %s" % (k, os.path.basename(v.get("subor", "?"))) for k, v in t.items()) if t else "  tapeta      —")
    print("  časti       " + ", ".join(k for k in d if k not in ("gooconfig", "ucet", "upravene")))
    return 0


def main(a):
    c = a[0] if a else ""
    if c == "cesta":
        print(DOC); return 0
    if c == "ukaz":
        return ukaz()
    if c == "zber":
        if zmeneny_zvonka():
            print("dokument bol zmenený mimo LatteOS — najprv `latte-gooconfig pouzi` (alebo ho zmaž, ak ho nechceš)", file=sys.stderr)
            return 1
        if not zber():
            print("dokument je aktuálny: " + DOC)
        return 0
    if c == "pouzi":
        rest = [x for x in a[1:] if x != "--hned"]
        return 0 if pouzi(rest[0] if rest else DOC, hned="--hned" in a) is not None else 1
    if c == "export" and len(a) == 2:
        if not zmeneny_zvonka():
            zber(quiet=True)
        d = nacitaj()
        if d is None:
            return 1
        fd = os.open(a[1], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(d, f, ensure_ascii=False, indent=1)
            f.write("\n")
        print(a[1]); return 0
    if c == "prihlasenie":
        if zmeneny_zvonka():
            pouzi(quiet=True)
        zber(quiet=True)
        return 0
    if c == "sleduj":
        try:
            sleduj()
        except KeyboardInterrupt:
            pass
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
