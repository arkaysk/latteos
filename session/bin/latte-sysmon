#!/usr/bin/python3
"""latte-sysmon — živý stav systému pre Monitor LatteOS (Process Manager) a iné zobrazovače.

  latte-sysmon stream [s]    JSON riadok každú sekundu (alebo každých s): CPU, RAM, disky, sieť, teploty, procesy
  latte-sysmon autorun       JSON: čo sa spúšťa pri štarte (XDG autostart, systemd user/system, časovače, cron,
                             štart relácie LatteOS, prihlasovacie skripty, environment.d, moduly jadra) — ako Autoruns
  latte-sysmon hw            JSON: hardvér ako CPU-Z/HWiNFO (procesor, cache, doska/BIOS, pamäť, grafika, disky,
                             senzory, batéria, systém)
  latte-sysmon once          jeden snímok (bez procesov)
  latte-sysmon hw-root       JSON (spúšťa sa so sudo): moduly pamäte a sloty (dmidecode, SPD s decode-dimms), pätica
                             a napätie CPU, doska, SMART diskov — Monitor si výsledok uloží do ~/.cache/latteos/hw-root.json
  latte-sysmon senzory       jeden snímok všetkých senzorov (ako HWiNFO: procesor po jadrách, hwmon, pamäť, disky,
                             sieť, grafika, batéria); v `stream` sú v poli "sensors"
  latte-sysmon zvuk          „hrá HLASITOSŤ slúchadlá stlmené“ (1/0 …) — Digitálna pohoda › Sluch
  latte-sysmon sukromie      riadky „mic|camera<TAB>aplikácia“: kto práve používa mikrofón alebo kameru (indikátor na lište)
  latte-sysmon rss PID       pamäť (RSS, kB) procesu aj s podprocesmi — pre Digitálnu pohodu
  latte-sysmon pohoda-den DÁTUM [TRIEDA]   JSON pre stránku Čas v aplikáciách: deň (spolu, priemer, včera,
                             týždeň, mesiac ako teplotná mapa, aplikácie, 48 polhodín), týždeň (mapa 7×24, najčastejšie
                             hodiny, aplikácie týždňa); s TRIEDOU iba pre jednu aplikáciu
  latte-sysmon pohoda [DNI]  JSON: Digitálna pohoda za posledných DNI dní (predvolene 7) — súčty po dňoch,
                             po aplikáciách (s .desktop id, názvom a ikonou), dnešné hodiny, obvyklá RAM

Telemetria: pri `stream` sa posledný snímok (bez zoznamu procesov) zapisuje aj do
$XDG_RUNTIME_DIR/latteos/telemetry.json — jednoduché lokálne rozhranie pre OLED displeje chladenia,
Stream Deck a pod. (old/IDEAS.md: „poskytuje údaje cez štandardné lokálne rozhranie“). Monitor nič
nekonfiguruje na cieľovom zariadení, iba dáva údaje.
Iba čítanie /proc a /sys, bez práv správcu.
"""
import glob, json, os, pwd, re, shutil, subprocess, sys, time

CLK = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
ME = os.getuid()
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "latteos")

# procesy prostredia LatteOS (ukončenie má vplyv na celú plochu → varovanie)
DESKTOP = {"Hyprland", "noctalia", "labwc", "qs", "quickshell", "greetd", "latte-session", "pipewire", "pipewire-pulse",
           "wireplumber", "dbus-broker", "dbus-broker-lau", "dbus-daemon", "xdg-desktop-portal", "xdg-desktop-portal-hyprland",
           "xdg-desktop-portal-gtk", "xdg-document-portal", "xdg-permission-store", "at-spi-bus-launcher", "at-spi2-registryd",
           "systemd", "Xwayland", "gvfsd", "dconf-service", "gnome-keyring-daemon"}


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().rstrip("\n")
    except OSError:
        return default


def cpu_times():
    out = []
    for line in read("/proc/stat").splitlines():
        if line.startswith("cpu"):
            f = line.split()
            v = list(map(int, f[1:9]))
            idle = v[3] + v[4]
            out.append((sum(v), idle))
    return out


def meminfo():
    m = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, rest = line.partition(":")
        m[k] = int(rest.split()[0]) * 1024 if rest.strip() else 0
    total = m.get("MemTotal", 0)
    avail = m.get("MemAvailable", 0)
    return {"total": total, "used": total - avail, "avail": avail,
            "swapTotal": m.get("SwapTotal", 0), "swapUsed": m.get("SwapTotal", 0) - m.get("SwapFree", 0)}


def disk_io():
    rd = wr = 0
    for line in read("/proc/diskstats").splitlines():
        f = line.split()
        name = f[2]
        if name.startswith(("loop", "ram", "zram", "dm-", "sr")) or name[-1].isdigit() and not name.startswith("nvme"):
            continue
        if name.startswith("nvme") and "p" in name[4:]:
            continue
        rd += int(f[5]) * 512
        wr += int(f[9]) * 512
    return rd, wr


def net_io():
    rx = tx = 0
    for line in read("/proc/net/dev").splitlines()[2:]:
        name, _, rest = line.partition(":")
        if name.strip() == "lo":
            continue
        f = rest.split()
        rx += int(f[0])
        tx += int(f[8])
    return rx, tx


def temps():
    out = []
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        name = read(d + "/name").strip()
        for t in sorted(glob.glob(d + "/temp*_input"))[:4]:
            try:
                c = int(read(t).strip()) / 1000
            except ValueError:
                continue
            label = read(t.replace("_input", "_label")).strip() or name
            out.append({"sensor": name, "label": label, "c": round(c, 1)})
    return out


def filesystems():
    out = []
    seen = set()
    for line in read("/proc/mounts").splitlines():
        dev, mnt, fs = line.split()[:3]
        if not dev.startswith("/dev/") or mnt.startswith(("/boot", "/snap")) or dev in seen:
            continue
        seen.add(dev)
        try:
            st = os.statvfs(mnt)
        except OSError:
            continue
        total = st.f_blocks * st.f_frsize
        out.append({"mount": mnt, "fs": fs, "total": total, "used": total - st.f_bavail * st.f_frsize})
    return out


def window_pids():
    """pid → kľúč aplikácie okna (trieda; aplikácie LatteOS majú všetky org.quickshell → „latte:<názov>“ z titulku)."""
    try:
        r = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=2)
        out = {}
        for c in json.loads(r.stdout or "[]"):
            cls, title = c.get("class") or "", c.get("title") or ""
            if cls == "org.quickshell":
                m = re.search(r" — (Heidelberg)$", title) or re.search(r"^(.*) — LatteOS$", title)
                cls = "latte:" + (m.group(1) if m else title)
            out[c["pid"]] = cls or title
        return out
    except Exception:
        return {}


APP_SCOPE = re.compile(r"/app-(?:flatpak-)?([^/]+?)(?:-\d+)?\.(?:scope|service)$")


def app_of(procs, wins):
    """Proces → aplikácia: cgroup Flatpaku / scope aplikácie systemd, inak najbližší predok s oknom."""
    by = {x["pid"]: x for x in procs}
    memo = {}

    def up(pid, depth=0):
        if pid in memo:
            return memo[pid]
        x = by.get(pid)
        res = ""
        if x is not None and depth < 64:
            cg = x.get("_cg", "")
            m = APP_SCOPE.search(cg)
            if pid in wins:
                res = wins[pid]
            elif m and not m.group(1).startswith(("dbus", "gnome-", "org.freedesktop", "xdg-")):
                res = m.group(1).replace("\\x2d", "-")
            elif x["ppid"] > 1:
                res = up(x["ppid"], depth + 1)
        memo[pid] = res
        return res

    for x in procs:
        x["app"] = up(x["pid"]) if x["mine"] else ""
        x.pop("_cg", None)


def device_use(procs):
    """pid → zariadenia, ktoré proces práve používa: gpu, kamera, mikrofón, zvuk (fd na /dev + streamy PipeWire)."""
    use = {}
    for x in procs:
        if not x["mine"] or x["name"] in ("pipewire", "pipewire-pulse", "wireplumber", "pulseaudio"):
            continue                                 # zvukový server drží zariadenia sám; rátajú sa jeho klienti (pactl)
        d = "/proc/%d/fd" % x["pid"]
        try:
            fds = os.listdir(d)
        except OSError:
            continue
        s = set()
        for fd in fds:
            try:
                t = os.readlink(d + "/" + fd)
            except OSError:
                continue
            if t.startswith("/dev/dri/renderD"):
                s.add("gpu")
            elif t.startswith("/dev/video"):
                s.add("camera")
            elif t.startswith("/dev/snd/pcm"):
                s.add("mic" if t.endswith("c") else "sound")
        if s:
            use[x["pid"]] = s
    for kind, what in (("sink-inputs", "sound"), ("source-outputs", "mic")):
        try:
            r = subprocess.run(["pactl", "-f", "json", "list", kind], capture_output=True, text=True, timeout=2)
            for st in json.loads(r.stdout or "[]"):
                pr = st.get("properties", {})
                if pr.get("media.class", "").startswith("Stream/Input/Video"):
                    what = "camera"
                if st.get("corked") and what == "sound":
                    continue                         # pozastavené prehrávanie sa neráta
                app_id = pr.get("pipewire.access.portal.app_id") or ""
                try:
                    pid = int(pr.get("application.process.id") or 0)
                except ValueError:
                    pid = 0
                key = pid if pid in {x["pid"] for x in procs} else ("app:" + app_id if app_id else None)
                if key is not None:
                    use.setdefault(key, set()).add(what)
        except Exception:
            pass
    return use


_APPNAMES = {}


def app_names(keys):
    """kľúč aplikácie → čitateľný názov (desktop súbor, inak kľúč)."""
    if not _APPNAMES.get("_idx"):
        _APPNAMES["_idx"] = desktop_index()
    idx = _APPNAMES["_idx"]
    out = {}
    for k in keys:
        if not k:
            continue
        if k.startswith("latte:"):
            out[k] = k[6:]
            continue
        e = idx.get(k.lower()) or idx.get(k.split(".")[-1].lower())
        out[k] = e[1] if e else k
    return out


USERS = {}


def user_of(uid):
    if uid not in USERS:
        try:
            USERS[uid] = pwd.getpwuid(uid).pw_name
        except KeyError:
            USERS[uid] = str(uid)
    return USERS[uid]


def processes(prev, dt, total_ticks, wins):
    procs, now = [], {}
    for pid_s in os.listdir("/proc"):
        if not pid_s.isdigit():
            continue
        pid = int(pid_s)
        stat = read("/proc/%d/stat" % pid)
        if not stat:
            continue
        try:
            name = stat[stat.index("(") + 1:stat.rindex(")")]
            f = stat[stat.rindex(")") + 2:].split()
            ppid, utime, stime, rss = int(f[1]), int(f[11]), int(f[12]), int(f[21]) * PAGE
            uid = os.stat("/proc/%d" % pid).st_uid
        except (ValueError, IndexError, OSError):
            continue
        ticks = utime + stime
        now[pid] = ticks
        cpu = 100.0 * (ticks - prev.get(pid, ticks)) / (CLK * dt) if dt > 0 else 0.0
        if uid != ME and uid != 0:
            kind = "system"
        elif uid == 0:
            kind = "system"
        elif pid in wins:
            kind = "app"
        elif name in DESKTOP or name.startswith(("xdg-", "gvfs")):
            kind = "desktop"
        else:
            kind = "helper"
        procs.append({"pid": pid, "ppid": ppid, "name": name, "user": user_of(uid), "cpu": round(cpu, 1), "rss": rss,
                      "kind": kind, "window": wins.get(pid, ""), "mine": uid == ME,
                      "_cg": read("/proc/%d/cgroup" % pid).rsplit(":", 1)[-1] if uid == ME else ""})
    app_of(procs, wins)
    return procs, now


def cmdline(pid):
    return read("/proc/%d/cmdline" % pid).replace("\0", " ").strip()


def cpu_freq():
    fs = [int(read(f, "0") or 0) for f in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq")]
    if fs:
        return round(sum(fs) / len(fs) / 1000)          # MHz
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("cpu MHz"):
            return round(float(line.split(":")[1]))
    return 0


def gpu_busy():
    """Vyťaženie GPU (amdgpu/i915 cez sysfs), VRAM pri amdgpu; None, keď ovládač nič nehlási (VM)."""
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]")):
        busy = read(card + "/device/gpu_busy_percent")
        if busy:
            out = {"busy": int(busy)}
            used, tot = read(card + "/device/mem_info_vram_used"), read(card + "/device/mem_info_vram_total")
            if used and tot:
                out.update(vramUsed=int(used), vramTotal=int(tot))
            return out
    return None


def snapshot(state, with_procs=True):
    t = time.monotonic()
    dt = t - state.get("t", t)
    cpus = cpu_times()
    prev = state.get("cpus", cpus)
    usage = []
    for (tot, idle), (ptot, pidle) in zip(cpus, prev):
        d = tot - ptot
        usage.append(round(100.0 * (1 - (idle - pidle) / d), 1) if d > 0 else 0.0)
    rd, wr = disk_io()
    rx, tx = net_io()
    p = state.get("io", (rd, wr, rx, tx))
    rate = lambda a, b: round((a - b) / dt) if dt > 0 else 0
    load = read("/proc/loadavg").split()[:3]
    snap = {
        "time": int(time.time()),
        "cpu": usage[0] if usage else 0, "cores": usage[1:],
        "mem": meminfo(),
        "disk": {"read": rate(rd, p[0]), "write": rate(wr, p[1])},
        "net": {"rx": rate(rx, p[2]), "tx": rate(tx, p[3])},
        "load": load, "uptime": int(float(read("/proc/uptime", "0 0").split()[0])),
        "temps": temps(), "fs": filesystems(),
        "freq": cpu_freq(), "gpu": gpu_busy(),
    }
    if with_procs:
        fresh = state.get("winT", 0) + 5 < t
        if fresh:                                 # okná z Hyprlandu raz za 5 s
            state["wins"], state["winT"] = window_pids(), t
        procs, ticks = processes(state.get("ticks", {}), dt, 0, state.get("wins", {}))
        if fresh or "devs" not in state:          # zariadenia tiež raz za 5 s
            state["devs"] = device_use(procs)
        devs = state["devs"]
        for x in procs:
            x["dev"] = sorted(devs.get(x["pid"], ()))
        procs.sort(key=lambda x: (-x["cpu"], -x["rss"]))
        for x in procs:                       # všetky (aj pre strom procesov v Monitore)
            x["cmd"] = cmdline(x["pid"])[:300]
        snap["procs"] = procs
        snap["procCount"] = len(procs)
        apps = {}                              # aplikácia → súčet procesov (Monitor › Procesy › podľa aplikácií)
        for x in procs:
            if x["app"]:
                a = apps.setdefault(x["app"], {"key": x["app"], "cpu": 0.0, "rss": 0, "n": 0, "dev": set()})
                a["cpu"] += x["cpu"]; a["rss"] += x["rss"]; a["n"] += 1; a["dev"].update(x["dev"])
        names = app_names(apps.keys())
        for a in apps.values():
            a["name"] = names.get(a["key"], a["key"]); a["cpu"] = round(a["cpu"], 1)
            a["dev"] = sorted(a["dev"] | devs.get("app:" + a["key"], set()))
        snap["apps"] = sorted(apps.values(), key=lambda a: (-a["cpu"], -a["rss"]))
        snap["threads"] = sum(int(read("/proc/%d/stat" % x["pid"], "0 " * 20).rsplit(")", 1)[-1].split()[17] or 0) for x in procs) if procs else 0
        state["ticks"] = ticks
    if state.get("withSensors"):
        snap["sensors"] = sensors_all(state)
    state.update(t=t, cpus=cpus, io=(rd, wr, rx, tx))
    return snap


def desktop_entries():
    out = []
    home = os.path.expanduser("~/.config/autostart")
    files = {}
    for d in ("/etc/xdg/autostart", home):
        for f in sorted(glob.glob(d + "/*.desktop")):
            files[os.path.basename(f)] = f          # používateľ prekryje systém
    for base, f in sorted(files.items()):
        kv = {}
        for line in read(f).splitlines():
            if "=" in line and not line.startswith("#"):
                k, _, v = line.partition("=")
                kv.setdefault(k.strip(), v.strip())
        only = kv.get("OnlyShowIn", "")
        out.append({"id": base, "kind": "autostart", "name": kv.get("Name", base), "command": kv.get("Exec", ""),
                    "origin": f, "owner": "používateľ" if f.startswith(home) else "systém",
                    "enabled": kv.get("Hidden", "false").lower() != "true" and kv.get("X-GNOME-Autostart-enabled", "true").lower() != "false",
                    "note": ("iba " + only) if only else "", "canToggle": True})
    return out


def systemd_units(user):
    base = ["systemctl"] + (["--user"] if user else [])
    out = []
    try:
        r = subprocess.run(base + ["list-unit-files", "--state=enabled", "--type=service,timer", "--no-legend", "--no-pager"],
                           capture_output=True, text=True, timeout=5)
    except Exception:
        return out
    for line in r.stdout.splitlines():
        f = line.split()
        if not f:
            continue
        unit = f[0]
        if unit.endswith("@.service"):
            continue
        out.append({"id": unit, "kind": "timer" if unit.endswith(".timer") else ("user-service" if user else "service"),
                    "name": unit.rsplit(".", 1)[0], "command": "", "origin": "systemd --user" if user else "systemd (systém)",
                    "owner": "používateľ" if user else "systém", "enabled": True, "canToggle": bool(user), "note": ""})
    return out


def cron():
    try:
        r = subprocess.run(["crontab", "-l"], capture_output=True, text=True, timeout=3)
    except Exception:
        return []
    out = []
    for i, line in enumerate(r.stdout.splitlines()):
        if line.strip() and not line.startswith("#"):
            out.append({"id": "cron:%d" % i, "kind": "cron", "name": line.split()[5] if len(line.split()) > 5 else line,
                        "command": line, "origin": "crontab -l", "owner": "používateľ", "enabled": True, "canToggle": False, "note": ""})
    return out


def exists_cmd(command):
    """Autoruns: „súbor chýba“, keď program z príkazu neexistuje."""
    import shlex, shutil
    try:
        argv = [x for x in shlex.split(command) if not (x.startswith("%") or "=" in x and not x.startswith("/"))]
    except ValueError:
        return True
    if not argv:
        return True
    if argv[0] in ("sh", "bash") and len(argv) > 2 and argv[1] == "-c":
        return exists_cmd(argv[2].split(";")[-1].strip())      # posledný príkaz skriptu (napr. „sleep 4; latte-app barista“)
    if argv[0] == "env" and len(argv) > 1:
        argv = argv[1:]
    prog = argv[0]
    return os.path.exists(prog) if prog.startswith("/") else shutil.which(prog) is not None


def session_items():
    """Štart relácie LatteOS (hyprland.lua hl.exec_cmd v hyprland.start) — iba na čítanie, mení sa v Nastaveniach."""
    out = []
    src = read("/usr/share/latteos/hypr/hyprland.lua")
    blk = src.split('hl.on("hyprland.start"', 1)[-1].split("\nend)", 1)[0] if 'hyprland.start' in src else ""
    for i, m in enumerate(__import__("re").finditer(r'hl\.exec_cmd\("((?:[^"\\]|\\.)*)"\)', blk)):
        c = m.group(1)
        inner = c.split("'")[1].split(";")[-1].strip() if c.startswith("sh -c '") and "'" in c[7:] else c
        w = inner.split()
        name = " ".join(w[:2]) if w and w[0] in ("latte-app", "latte-boot", "wl-paste", "systemctl") else (w[0] if w else c)
        nice = {"noctalia": "Shell Noctalia (lišta, panely)", "latte-app zivatapeta": "Živá tapeta", "latte-app netznak": "NET pre okná",
                "latte-app kapsavyrez": "Výrez Kapsy (súbory na lište)", "latte-app nahlad": "Živý náhľad okien", "latte-app plocha": "Ikony na ploche a Kôš",
                "latte-app barista": "Barista (prvé spustenie)", "latte-boot ok": "Kontrola zdravia relácie (SAFE pri páde)"}
        if name == "wl-paste --type":
            name = "História schránky (" + ("obrázky" if "image" in c else "text") + ")"
        name = nice.get(name, name)
        out.append({"id": "session:%d" % i, "kind": "session", "name": name, "command": c, "origin": "/usr/share/latteos/hypr/hyprland.lua",
                    "owner": "LatteOS", "enabled": True, "canToggle": False, "note": ""})
    return out


def login_scripts():
    out = []
    home = os.path.expanduser("~")
    for f in (".bash_profile", ".profile", ".bashrc", ".zprofile", ".zshrc"):
        p = os.path.join(home, f)
        if os.path.exists(p):
            n = sum(1 for l in read(p).splitlines() if l.strip() and not l.strip().startswith("#"))
            out.append({"id": "login:" + f, "kind": "login", "name": f, "command": "%d príkazov" % n, "origin": p,
                        "owner": "používateľ", "enabled": True, "canToggle": False, "note": ""})
    for d, owner in ((home + "/.config/environment.d", "používateľ"), ("/etc/environment.d", "systém"), ("/usr/lib/environment.d", "systém")):
        for p in sorted(glob.glob(d + "/*.conf")):
            out.append({"id": "env:" + p, "kind": "login", "name": os.path.basename(p), "command": " ".join(l.split("=")[0] for l in read(p).splitlines() if "=" in l and not l.startswith("#"))[:120],
                        "origin": p, "owner": owner, "enabled": True, "canToggle": False, "note": "premenné prostredia"})
    return out


def kernel_modules():
    out = []
    for d in ("/etc/modules-load.d", "/usr/lib/modules-load.d"):
        for p in sorted(glob.glob(d + "/*.conf")):
            mods = [l.strip() for l in read(p).splitlines() if l.strip() and not l.startswith("#")]
            if mods:
                out.append({"id": "mod:" + p, "kind": "module", "name": os.path.basename(p), "command": ", ".join(mods)[:120], "origin": p,
                            "owner": "systém", "enabled": True, "canToggle": False, "note": ""})
    return out


# kódové mená podľa (výrobca, rodina, model) — výber bežných desktopových a notebookových CPU
INTEL_CODENAMES = {42: ("Sandy Bridge", 32), 45: ("Sandy Bridge-E", 32), 58: ("Ivy Bridge", 22), 62: ("Ivy Bridge-E", 22),
                   60: ("Haswell", 22), 69: ("Haswell", 22), 70: ("Haswell", 22), 63: ("Haswell-E", 22), 61: ("Broadwell", 14),
                   71: ("Broadwell", 14), 79: ("Broadwell-E", 14), 78: ("Skylake", 14), 94: ("Skylake", 14), 85: ("Skylake-X / Cascade Lake", 14),
                   142: ("Kaby / Coffee / Whiskey Lake", 14), 158: ("Kaby / Coffee Lake", 14), 165: ("Comet Lake", 14), 166: ("Comet Lake", 14),
                   125: ("Ice Lake", 10), 126: ("Ice Lake", 10), 140: ("Tiger Lake", 10), 141: ("Tiger Lake", 10), 167: ("Rocket Lake", 14),
                   151: ("Alder Lake", 10), 154: ("Alder Lake", 10), 183: ("Raptor Lake", 10), 186: ("Raptor Lake", 10), 191: ("Raptor Lake", 10),
                   170: ("Meteor Lake", 7), 172: ("Meteor Lake", 7), 189: ("Lunar Lake", 3), 197: ("Arrow Lake", 3), 198: ("Arrow Lake", 3),
                   204: ("Panther Lake", 2)}
AMD_CODENAMES = {(23, 1): ("Summit Ridge / Naples (Zen)", 14), (23, 8): ("Pinnacle Ridge (Zen+)", 12), (23, 17): ("Raven Ridge", 14),
                 (23, 24): ("Picasso", 12), (23, 49): ("Matisse / Rome (Zen 2)", 7), (23, 96): ("Renoir (Zen 2)", 7), (23, 104): ("Lucienne", 7),
                 (23, 113): ("Matisse (Zen 2)", 7), (23, 144): ("Van Gogh", 7), (25, 1): ("Milan (Zen 3)", 7), (25, 33): ("Vermeer (Zen 3)", 7),
                 (25, 80): ("Cezanne (Zen 3)", 7), (25, 68): ("Rembrandt (Zen 3+)", 6), (25, 97): ("Raphael (Zen 4)", 5),
                 (25, 116): ("Phoenix (Zen 4)", 4), (25, 117): ("Phoenix (Zen 4)", 4), (26, 68): ("Granite Ridge (Zen 5)", 4),
                 (26, 36): ("Strix Point (Zen 5)", 4), (26, 112): ("Strix Halo (Zen 5)", 4)}
INSTR_ORDER = [("mmx", "MMX"), ("sse", "SSE"), ("sse2", "SSE2"), ("pni", "SSE3"), ("ssse3", "SSSE3"), ("sse4_1", "SSE4.1"),
               ("sse4_2", "SSE4.2"), ("sse4a", "SSE4A"), ("lm", "EM64T / x86-64"), ("vmx", "VT-x"), ("svm", "AMD-V"), ("aes", "AES"),
               ("avx", "AVX"), ("avx2", "AVX2"), ("avx512f", "AVX-512F"), ("avx512_vnni", "AVX-512 VNNI"), ("avx_vnni", "AVX-VNNI"),
               ("fma", "FMA3"), ("f16c", "F16C"), ("sha_ni", "SHA"), ("bmi2", "BMI2"), ("adx", "ADX"), ("rdrand", "RDRAND"), ("rdseed", "RDSEED")]


def human_kib(kib):
    kib = int(kib)
    return "%d MB" % (kib // 1024) if kib >= 1024 and kib % 1024 == 0 else ("%.1f MB" % (kib / 1024) if kib >= 1024 else "%d KB" % kib)


def cache_levels():
    """CPU-Z › Cache: úrovne s počtom inštancií (2 × 32 KB), asociativita, dĺžka riadku, zdieľanie."""
    out, seen = [], {}
    for cpu in sorted(glob.glob("/sys/devices/system/cpu/cpu[0-9]*"), key=lambda c: int(re.sub(r"\D", "", c) or 0)):
        for idx in sorted(glob.glob(cpu + "/cache/index*")):
            lvl = "L" + read(idx + "/level") + ({"Data": "d", "Instruction": "i"}.get(read(idx + "/type"), ""))
            shared = read(idx + "/shared_cpu_list")
            e = seen.setdefault(lvl, {"level": lvl, "size": read(idx + "/size"), "ways": read(idx + "/ways_of_associativity"),
                                      "line": read(idx + "/coherency_line_size"), "sets": read(idx + "/number_of_sets"),
                                      "sharedBy": shared, "_inst": set()})
            e["_inst"].add(shared)
    for e in seen.values():
        e["count"] = len(e.pop("_inst"))
        kib = int(re.sub(r"\D", "", e["size"]) or 0)
        e["text"] = (("%d × " % e["count"]) if e["count"] > 1 else "") + human_kib(kib) + (" · %s-cestná" % e["ways"] if e["ways"] else "")
        out.append(e)
    order = {"L1d": 0, "L1i": 1, "L2": 2, "L3": 3, "L4": 4}
    return sorted(out, key=lambda e: order.get(e["level"], 9))


def core_clocks():
    out = []
    for c in sorted(glob.glob("/sys/devices/system/cpu/cpu[0-9]*"), key=lambda c: int(re.sub(r"\D", "", c) or 0)):
        v = read(c + "/cpufreq/scaling_cur_freq")
        out.append(int(v) // 1000 if v.isdigit() else 0)
    if not any(out):                                     # VM bez cpufreq: z /proc/cpuinfo
        out = [int(float(m)) for m in re.findall(r"^cpu MHz\s*:\s*([\d.]+)", read("/proc/cpuinfo"), re.M)]
    return out


def dmi_sections(text):
    """dmidecode → zoznam sekcií {"_type": "Memory Device", kľúč: hodnota}."""
    out, cur = [], None
    for line in text.splitlines():
        if not line.strip():
            continue
        if not line.startswith(("\t", " ")):
            if line.startswith("Handle"):
                cur = None
            else:
                cur = {"_type": line.strip()}
                out.append(cur)
        elif cur is not None and ":" in line and line.startswith("\t") and not line.startswith("\t\t"):
            k, _, v = line.strip().partition(":")
            cur[k.strip()] = v.strip()
    return out


def hardware_root():
    """Podrobnosti, ktoré Linux dáva iba správcovi (spúšťa Monitor cez sudo -S)."""
    info = {"time": int(time.time())}
    try:
        secs = dmi_sections(subprocess.run(["dmidecode", "-t", "2,4,16,17"], capture_output=True, text=True, timeout=10).stdout)
    except Exception:
        secs = []
    cpu = next((x for x in secs if x["_type"] == "Processor Information"), {})
    info["cpu"] = {"socket": cpu.get("Socket Designation", ""), "upgrade": cpu.get("Upgrade", ""), "voltage": cpu.get("Voltage", ""),
                   "extClock": cpu.get("External Clock", ""), "maxSpeed": cpu.get("Max Speed", ""), "family": cpu.get("Family", "")}
    board = next((x for x in secs if x["_type"] == "Base Board Information"), {})
    info["board"] = {"serial": board.get("Serial Number", ""), "version": board.get("Version", "")}
    arr = next((x for x in secs if x["_type"] == "Physical Memory Array"), {})
    info["memArray"] = {"maxCapacity": arr.get("Maximum Capacity", ""), "slots": arr.get("Number Of Devices", ""),
                        "ecc": arr.get("Error Correction Type", "")}
    mods = []
    for d in secs:
        if d["_type"] != "Memory Device":
            continue
        empty = d.get("Size", "").startswith(("No Module", "Not Installed")) or not d.get("Size")
        mods.append({"slot": d.get("Locator", ""), "bank": d.get("Bank Locator", ""), "size": "" if empty else d.get("Size", ""),
                     "type": d.get("Type", ""), "form": d.get("Form Factor", ""), "speed": d.get("Speed", ""),
                     "configured": d.get("Configured Memory Speed", d.get("Configured Clock Speed", "")),
                     "maker": d.get("Manufacturer", ""), "part": d.get("Part Number", "").strip(), "serial": d.get("Serial Number", ""),
                     "rank": d.get("Rank", ""), "voltage": d.get("Configured Voltage", ""), "width": d.get("Data Width", ""), "empty": empty})
    info["modules"] = mods
    # SPD časovania (i2c-tools; moduly ee1004/at24 musia byť načítané)
    spd = ""
    if shutil.which("decode-dimms"):
        try:
            spd = subprocess.run(["decode-dimms"], capture_output=True, text=True, timeout=20).stdout
        except Exception:
            spd = ""
    info["spdTimings"] = re.findall(r"^(tCL|tRCD|tRP|tRAS|Minimum Cycle Time|Supported CAS Latencies|tCK min|.*Timings at.*)\s{2,}(.+)$", spd, re.M)[:40]
    # SMART
    disks = []
    try:
        names = [d["name"] for d in json.loads(subprocess.run(["lsblk", "-J", "-d", "-o", "NAME,TYPE"], capture_output=True, text=True, timeout=3).stdout)["blockdevices"]
                 if d.get("type") == "disk" and not d["name"].startswith(("zram", "loop"))]
    except Exception:
        names = []
    for n in names:
        try:
            j = json.loads(subprocess.run(["smartctl", "-j", "-a", "/dev/" + n], capture_output=True, text=True, timeout=15).stdout or "{}")
        except Exception:
            continue
        written = None
        nv = j.get("nvme_smart_health_information_log") or {}
        if nv.get("data_units_written"):
            written = nv["data_units_written"] * 512000
        for a in (j.get("ata_smart_attributes") or {}).get("table", []):
            if a.get("id") == 241 and a.get("raw", {}).get("value"):
                written = a["raw"]["value"] * (j.get("logical_block_size") or 512)
        disks.append({"name": n, "model": j.get("model_name", ""), "serial": j.get("serial_number", ""), "firmware": j.get("firmware_version", ""),
                      "healthy": (j.get("smart_status") or {}).get("passed"), "temp": (j.get("temperature") or {}).get("current"),
                      "hours": (j.get("power_on_time") or {}).get("hours"), "cycles": j.get("power_cycle_count"),
                      "written": written, "rpm": j.get("rotation_rate"), "smart": (j.get("smart_support") or {}).get("available"),
                      "wear": nv.get("percentage_used")})
    info["smart"] = disks
    return info


def sensors_all(state):
    """Senzory ako HWiNFO: skupiny → položky {id, label, value, unit, kind}. Rýchlosti z rozdielu voči state."""
    t = time.monotonic()
    dt = t - state.get("sT", t)
    groups = []

    def g(name, glyph, items):
        if items:
            groups.append({"name": name, "glyph": glyph, "items": items})

    # procesor: takty jadier, využitie jadier
    clocks = core_clocks()
    cpus = cpu_times()
    prev = state.get("sCpu", cpus)
    use = []
    for (tot, idle), (ptot, pidle) in zip(cpus, prev):
        d = tot - ptot
        use.append(round(100.0 * (1 - (idle - pidle) / d), 1) if d > 0 else 0.0)
    state["sCpu"] = cpus
    items = [{"id": "cpu.use", "label": "Využitie procesora", "value": use[0] if use else 0, "unit": "%"}]
    items += [{"id": "cpu.use%d" % i, "label": "Jadro %d · využitie" % i, "value": v, "unit": "%"} for i, v in enumerate(use[1:])]
    items += [{"id": "cpu.clk%d" % i, "label": "Jadro %d · takt" % i, "value": v, "unit": "MHz"} for i, v in enumerate(clocks) if v]
    # RAPL (výkon balíka) — novšie jadrá dovolia čítať iba správcovi
    for z in sorted(glob.glob("/sys/class/powercap/intel-rapl:[0-9]")):
        e = read(z + "/energy_uj")
        if e.isdigit():
            pe = state.get("rapl" + z)
            state["rapl" + z] = int(e)
            if pe is not None and dt > 0 and int(e) >= pe:
                items.append({"id": "cpu.power." + os.path.basename(z), "label": "Výkon · " + (read(z + "/name") or "balík"), "value": round((int(e) - pe) / 1e6 / dt, 1), "unit": "W"})
    g("Procesor", "cpu", items)
    # hwmon čipy
    for hw in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        chip = read(hw + "/name") or os.path.basename(hw)
        items = []
        for f in sorted(glob.glob(hw + "/*_input"), key=lambda x: (re.sub(r"\d+", "", os.path.basename(x)), int(re.sub(r"\D", "", os.path.basename(x)) or 0))):
            base = f[:-6]
            kind = re.sub(r"\d+$", "", os.path.basename(base))
            v = read(f)
            if not re.match(r"^-?\d+$", v):
                continue
            val = int(v)
            conv = {"temp": (1000, "°C"), "in": (1000, "V"), "fan": (1, "ot/min"), "power": (1e6, "W"), "curr": (1000, "A"), "energy": (1e6, "J"), "freq": (1e6, "MHz")}
            if kind not in conv:
                continue
            div, unit = conv[kind]
            items.append({"id": "hw.%s.%s" % (chip, os.path.basename(base)), "label": read(base + "_label") or os.path.basename(base),
                          "value": round(val / div, 3 if unit == "V" else 1), "unit": unit,
                          "crit": round(int(read(base + "_crit")) / div, 1) if read(base + "_crit").lstrip("-").isdigit() else None})
        if chip == "AC" and not items:
            continue
        g({"coretemp": "Procesor · teploty", "k10temp": "Procesor · teploty (AMD)", "nvme": "NVMe disk", "drivetemp": "Disk · teplota",
           "amdgpu": "Grafika AMD", "nouveau": "Grafika NVIDIA (nouveau)", "acpitz": "ACPI zóna", "iwlwifi_1": "Wi-Fi"}.get(chip, "Čip " + chip), "activity", items)
    # pamäť
    m = meminfo()
    mi = {k: int(v.split()[0]) * 1024 for k, v in (l.split(":", 1) for l in read("/proc/meminfo").splitlines() if ":" in l)}
    g("Pamäť", "database", [
        {"id": "mem.used", "label": "Použitá pamäť", "value": round(m["used"] / 2**20), "unit": "MB"},
        {"id": "mem.avail", "label": "Dostupná pamäť", "value": round(mi.get("MemAvailable", 0) / 2**20), "unit": "MB"},
        {"id": "mem.load", "label": "Zaťaženie pamäte", "value": round(100 * m["used"] / max(1, m["total"]), 1), "unit": "%"},
        {"id": "mem.cache", "label": "Vyrovnávacia pamäť (cache)", "value": round(mi.get("Cached", 0) / 2**20), "unit": "MB"},
        {"id": "mem.swap", "label": "Použitý swap", "value": round((mi.get("SwapTotal", 0) - mi.get("SwapFree", 0)) / 2**20), "unit": "MB"}])
    # disky: čítanie/zápis po zariadeniach
    cur = {}
    for line in read("/proc/diskstats").splitlines():
        f = line.split()
        if len(f) > 13 and re.match(r"^(sd[a-z]+|nvme\d+n\d+|vd[a-z]+|mmcblk\d+)$", f[2]):
            cur[f[2]] = (int(f[5]) * 512, int(f[9]) * 512, int(f[12]))
    pd = state.get("sDisk", cur)
    state["sDisk"] = cur
    for dev, (r, w, busy) in sorted(cur.items()):
        p = pd.get(dev, (r, w, busy))
        rate = lambda a, b: round((a - b) / dt / 2**20, 2) if dt > 0 else 0
        g("Disk " + dev, "database", [
            {"id": "disk.%s.read" % dev, "label": "Čítanie", "value": rate(r, p[0]), "unit": "MB/s"},
            {"id": "disk.%s.write" % dev, "label": "Zápis", "value": rate(w, p[1]), "unit": "MB/s"},
            {"id": "disk.%s.busy" % dev, "label": "Aktivita", "value": min(100.0, round((busy - p[2]) / 10 / dt, 1)) if dt > 0 else 0, "unit": "%"}])
    # sieť po rozhraniach
    cur = {}
    for line in read("/proc/net/dev").splitlines()[2:]:
        name, _, rest = line.partition(":")
        name = name.strip()
        if name == "lo" or not rest:
            continue
        f = rest.split()
        cur[name] = (int(f[0]), int(f[8]))
    pn = state.get("sNet", cur)
    state["sNet"] = cur
    for dev, (rx, tx) in sorted(cur.items()):
        p = pn.get(dev, (rx, tx))
        g("Sieť " + dev, "world", [
            {"id": "net.%s.rx" % dev, "label": "Príjem", "value": round((rx - p[0]) / dt / 1024, 1) if dt > 0 else 0, "unit": "KB/s"},
            {"id": "net.%s.tx" % dev, "label": "Odosielanie", "value": round((tx - p[1]) / dt / 1024, 1) if dt > 0 else 0, "unit": "KB/s"},
            {"id": "net.%s.total" % dev, "label": "Prijaté spolu", "value": round(rx / 2**20), "unit": "MB"}])
    # grafika (sysfs amdgpu/i915/xe)
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]")):
        dev = card + "/device"
        items = []
        b = read(dev + "/gpu_busy_percent")
        if b.isdigit():
            items.append({"id": "gpu.%s.busy" % os.path.basename(card), "label": "Záťaž GPU", "value": int(b), "unit": "%"})
        vu, vt = read(dev + "/mem_info_vram_used"), read(dev + "/mem_info_vram_total")
        if vu.isdigit():
            items.append({"id": "gpu.%s.vram" % os.path.basename(card), "label": "Použitá VRAM", "value": round(int(vu) / 2**20), "unit": "MB"})
        m2 = re.search(r"^\d+: (\d+)Mhz \*", read(dev + "/pp_dpm_sclk"), re.M)
        if m2:
            items.append({"id": "gpu.%s.sclk" % os.path.basename(card), "label": "Takt jadra GPU", "value": int(m2.group(1)), "unit": "MHz"})
        m3 = re.search(r"^\d+: (\d+)Mhz \*", read(dev + "/pp_dpm_mclk"), re.M)
        if m3:
            items.append({"id": "gpu.%s.mclk" % os.path.basename(card), "label": "Takt pamäte GPU", "value": int(m3.group(1)), "unit": "MHz"})
        act = read(card + "/gt_act_freq_mhz") or read(card + "/gt/gt0/rps_act_freq_mhz")
        if act.isdigit():
            items.append({"id": "gpu.%s.act" % os.path.basename(card), "label": "Takt GPU (Intel)", "value": int(act), "unit": "MHz"})
        g("Grafika " + os.path.basename(card), "device-desktop", items)
    # batéria
    for bat in sorted(glob.glob("/sys/class/power_supply/BAT*")):
        n = os.path.basename(bat)
        pw, vn = read(bat + "/power_now"), read(bat + "/voltage_now")
        g("Batéria " + n, "battery", [x for x in [
            {"id": "bat.%s.cap" % n, "label": "Nabitie", "value": int(read(bat + "/capacity") or 0), "unit": "%"},
            {"id": "bat.%s.pw" % n, "label": "Príkon", "value": round(int(pw) / 1e6, 2), "unit": "W"} if pw.isdigit() else None,
            {"id": "bat.%s.v" % n, "label": "Napätie", "value": round(int(vn) / 1e6, 3), "unit": "V"} if vn.isdigit() else None] if x])
    la = read("/proc/loadavg").split()
    g("Systém", "info-circle", [{"id": "sys.load1", "label": "Záťaž (1 min)", "value": float(la[0]) if la else 0, "unit": ""},
                                {"id": "sys.procs", "label": "Bežiace procesy", "value": int(la[3].split("/")[1]) if len(la) > 3 else 0, "unit": ""}])
    state["sT"] = t
    return groups


def hardware():
    info = {}
    # procesor (CPU-Z: Procesor, Cache)
    ci = {}
    for line in read("/proc/cpuinfo").splitlines():
        if ":" in line:
            k, _, v = line.partition(":")
            ci.setdefault(k.strip(), v.strip())
    flags = ci.get("flags", "").split()
    cores = len({(read(f.replace("core_id", "physical_package_id")), read(f)) for f in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/topology/core_id")}) or int(ci.get("cpu cores", "0") or 0)
    threads = len(glob.glob("/sys/devices/system/cpu/cpu[0-9]*"))
    cache = []
    for idx in sorted(glob.glob("/sys/devices/system/cpu/cpu0/cache/index*")):
        cache.append({"level": "L" + read(idx + "/level") + ({"Data": "d", "Instruction": "i"}.get(read(idx + "/type"), "")), "size": read(idx + "/size"),
                      "ways": read(idx + "/ways_of_associativity")})
    mx = read("/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq")
    mn = read("/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_min_freq")
    notable = [f for f in ("sse4_2", "avx", "avx2", "avx512f", "aes", "sha_ni", "fma", "vmx", "svm", "hypervisor") if f in flags]
    fam, mod = int(ci.get("cpu family", "0") or 0), int(ci.get("model", "0") or 0)
    if ci.get("vendor_id") == "GenuineIntel" and fam == 6:
        code, nm = INTEL_CODENAMES.get(mod, ("", 0))
    elif ci.get("vendor_id") == "AuthenticAMD":
        code, nm = AMD_CODENAMES.get((fam, mod), ("", 0))
    else:
        code, nm = "", 0
    base = read("/sys/devices/system/cpu/cpu0/cpufreq/base_frequency")
    mname = ci.get("model name", "?")
    spec_mhz = re.search(r"@\s*([\d.]+)\s*GHz", mname)
    base_mhz = int(base) // 1000 if base.isdigit() else (int(float(spec_mhz.group(1)) * 1000) if spec_mhz else 0)
    info["cpuz"] = {"codename": code, "nm": nm, "baseMHz": base_mhz, "clocks": core_clocks(), "caches": cache_levels(),
                    "instructions": [n for f, n in INSTR_ORDER if f in flags],
                    "extFamily": hex(fam), "extModel": hex(mod), "addr": re.search(r"address sizes\s*:\s*(.+)", read("/proc/cpuinfo")).group(1) if "address sizes" in read("/proc/cpuinfo") else "",
                    "sockets": len({read(f) for f in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/topology/physical_package_id")}) or 1,
                    "vulns": sorted(os.path.basename(v) for v in glob.glob("/sys/devices/system/cpu/vulnerabilities/*") if read(v).startswith("Vulnerable"))}
    info["cpu"] = {"model": ci.get("model name", "?"), "vendor": ci.get("vendor_id", ""), "family": ci.get("cpu family", ""), "modelId": ci.get("model", ""),
                   "stepping": ci.get("stepping", ""), "microcode": ci.get("microcode", ""), "cores": cores, "threads": threads,
                   "maxMHz": int(mx) // 1000 if mx else 0, "minMHz": int(mn) // 1000 if mn else 0, "curMHz": cpu_freq(),
                   "cache": cache, "flags": notable, "bogomips": ci.get("bogomips", ""),
                   "governor": read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor")}
    # doska a BIOS (čitateľné bez správcu)
    dmi = lambda k: read("/sys/class/dmi/id/" + k)
    info["board"] = {k: dmi(k) for k in ("sys_vendor", "product_name", "product_version", "board_vendor", "board_name", "board_version",
                                         "bios_vendor", "bios_version", "bios_date", "chassis_type")}
    info["board"]["efi"] = os.path.isdir("/sys/firmware/efi")
    info["board"]["secureBoot"] = None
    sb = glob.glob("/sys/firmware/efi/efivars/SecureBoot-*")
    if sb:
        try:
            info["board"]["secureBoot"] = open(sb[0], "rb").read()[-1] == 1
        except OSError:
            pass
    # pamäť
    m = meminfo()
    mi = {k: int(v.split()[0]) * 1024 for k, v in (l.split(":", 1) for l in read("/proc/meminfo").splitlines() if ":" in l and v.split())}
    info["memory"] = {"total": m.get("total", 0), "hugepages": mi.get("HugePages_Total", 0), "cached": mi.get("Cached", 0), "swap": int(read("/proc/meminfo").split("SwapTotal:")[1].split()[0]) * 1024 if "SwapTotal:" in read("/proc/meminfo") else 0,
                      "note": "typ a frekvencia modulov vyžadujú správcu (dmidecode)"}
    # grafika
    gpus = []
    try:
        r = subprocess.run(["lspci", "-mm", "-nn"], capture_output=True, text=True, timeout=3)
        for line in r.stdout.splitlines():
            if "VGA" in line or "3D controller" in line or "Display" in line:
                f = [x.strip('"') for x in __import__("shlex").split(line)]
                gpus.append({"vendor": f[2] if len(f) > 2 else "", "name": f[3] if len(f) > 3 else line, "slot": f[0]})
    except Exception:
        pass
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]")):
        drv = os.path.basename(os.path.realpath(card + "/device/driver")) if os.path.exists(card + "/device/driver") else ""
        vram = read(card + "/device/mem_info_vram_total")
        slot = os.path.basename(os.path.realpath(card + "/device"))
        for g in gpus:
            if slot.endswith(g["slot"]):
                g.update(driver=drv, vram=int(vram) if vram else 0)
    for g in gpus:                                        # PCIe linka (HWiNFO: PCIe Link Speed)
        dev = "/sys/bus/pci/devices/" + (g["slot"] if g["slot"].count(":") == 2 else "0000:" + g["slot"])
        g["link"] = (read(dev + "/current_link_speed") + " ×" + read(dev + "/current_link_width")).strip(" ×") if read(dev + "/current_link_speed") else ""
        g["linkMax"] = (read(dev + "/max_link_speed") + " ×" + read(dev + "/max_link_width")).strip(" ×") if read(dev + "/max_link_speed") else ""
    info["gpu"] = gpus
    gl = {}
    try:
        out = subprocess.run(["eglinfo", "-B"], capture_output=True, text=True, timeout=5).stdout
        for k, rx in (("renderer", r"OpenGL core profile renderer: (.+)"), ("version", r"OpenGL core profile version: (.+)"),
                      ("glsl", r"OpenGL core profile shading language version: (.+)"), ("es", r"OpenGL ES profile version: (.+)")):
            mm = re.search(rx, out)
            gl[k] = mm.group(1).strip() if mm else ""
    except Exception:
        pass
    try:
        out = subprocess.run(["vulkaninfo", "--summary"], capture_output=True, text=True, timeout=8).stdout
        gl["vulkan"] = [{"device": d, "api": a, "driver": v} for d, a, v in zip(re.findall(r"deviceName\s*=\s*(.+)", out), re.findall(r"apiVersion\s*=\s*(.+)", out),
                                                                                 re.findall(r"driverName\s*=\s*(.+)", out))]
    except Exception:
        gl["vulkan"] = []
    info["gl"] = gl
    # čipová sada (hostiteľský a ISA most)
    chip = []
    try:
        for line in subprocess.run(["lspci", "-mm"], capture_output=True, text=True, timeout=3).stdout.splitlines():
            f = __import__("shlex").split(line)
            if len(f) > 3 and f[1] in ("Host bridge", "ISA bridge"):
                chip.append({"kind": f[1], "vendor": f[2], "name": f[3]})
    except Exception:
        pass
    info["chipset"] = chip
    info["renderer"] = read("/run/latteos/mode.toml")
    # disky
    disks = []
    try:
        r = subprocess.run(["lsblk", "-J", "-b", "-d", "-o", "NAME,MODEL,SIZE,ROTA,TRAN,TYPE,SERIAL,REV"], capture_output=True, text=True, timeout=3)
        for d in json.loads(r.stdout).get("blockdevices", []):
            if d.get("type") == "disk" and not (d.get("name") or "").startswith(("zram", "loop")):
                disks.append({"name": d.get("name"), "model": (d.get("model") or "").strip(), "size": int(d.get("size") or 0),
                              "kind": "HDD" if d.get("rota") in (True, "1", 1) else ("NVMe" if (d.get("name") or "").startswith("nvme") else "SSD"),
                              "bus": d.get("tran") or "", "rev": d.get("rev") or ""})
    except Exception:
        pass
    info["disks"] = disks
    # senzory (HWiNFO): hwmon teploty, ventilátory, napätia
    sensors = []
    for hw in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        chip = read(hw + "/name")
        for f in sorted(glob.glob(hw + "/*_input")):
            base = f[:-6]
            kind = os.path.basename(base).rstrip("0123456789")
            v = read(f)
            if not v:
                continue
            label = read(base + "_label") or os.path.basename(base)
            val, unit = int(v), ""
            if kind == "temp":
                val, unit = round(val / 1000, 1), "°C"
            elif kind == "in":
                val, unit = round(val / 1000, 3), "V"
            elif kind == "fan":
                unit = "ot/min"
            elif kind == "power":
                val, unit = round(val / 1e6, 1), "W"
            else:
                continue
            sensors.append({"chip": chip, "label": label, "value": val, "unit": unit})
    info["sensors"] = sensors
    # batéria
    bats = []
    for b in sorted(glob.glob("/sys/class/power_supply/BAT*")):
        full, design = read(b + "/energy_full") or read(b + "/charge_full"), read(b + "/energy_full_design") or read(b + "/charge_full_design")
        bats.append({"name": os.path.basename(b), "capacity": int(read(b + "/capacity") or 0), "status": read(b + "/status"),
                     "health": round(100 * int(full) / int(design)) if full and design and int(design) else None,
                     "cycles": read(b + "/cycle_count"), "model": read(b + "/model_name")})
    info["battery"] = bats
    # systém
    osr = {}
    for line in read("/etc/os-release").splitlines():
        k, _, v = line.partition("=")
        osr[k] = v.strip('"')
    info["system"] = {"os": osr.get("PRETTY_NAME", ""), "kernel": os.uname().release, "arch": os.uname().machine, "host": os.uname().nodename,
                      "virt": subprocess.run(["systemd-detect-virt"], capture_output=True, text=True).stdout.strip() or "none",
                      "uptime": int(float(read("/proc/uptime", "0 0").split()[0]))}
    return info


def tree_rss(root):
    kids = {}
    for d in os.listdir("/proc"):
        if d.isdigit():
            try:
                ppid = read("/proc/%s/stat" % d).rsplit(")", 1)[1].split()[1]
            except IndexError:
                continue
            kids.setdefault(ppid, []).append(d)
    total, todo = 0, [str(root)]
    while todo:
        p = todo.pop()
        for line in read("/proc/%s/status" % p).splitlines():
            if line.startswith("VmRSS:"):
                total += int(line.split()[1])
        todo.extend(kids.get(p, []))
    return total


def desktop_index():
    """trieda okna → (desktop id, názov, ikona) podľa StartupWMClass alebo id súboru."""
    home = os.path.expanduser("~")
    idx = {}
    for d in (home + "/.local/share/flatpak/exports/share/applications", "/var/lib/flatpak/exports/share/applications",
              "/usr/share/applications", home + "/.local/share/applications"):
        for f in glob.glob(d + "/*.desktop"):
            did = os.path.basename(f)[:-8]
            kv = {}
            for line in read(f).splitlines():
                if line.startswith("[") and line != "[Desktop Entry]" and kv:
                    break
                if "=" in line:
                    k, _, v = line.partition("=")
                    kv.setdefault(k.strip(), v.strip())
            ent = (did, kv.get("Name[sk]") or kv.get("Name", did), kv.get("Icon", ""), kv.get("Categories", ""))
            for key in {did.lower(), did.split(".")[-1].lower(), kv.get("StartupWMClass", "").lower()} - {""}:
                idx.setdefault(key, ent)
    return idx


def pohoda(days):
    import datetime
    base = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "latteos", "pohoda")
    idx = desktop_index()
    today = datetime.date.today()
    out = {"days": [], "apps": {}, "today": {}, "hours": [0] * 24, "hoursApps": [{} for _ in range(24)], "total": 0}
    for i in range(days - 1, -1, -1):
        d = (today - datetime.timedelta(days=i)).isoformat()
        try:
            j = json.load(open(os.path.join(base, d + ".json")))
        except (OSError, ValueError):
            j = {"apps": {}, "hours": []}
        tot = sum(a.get("s", 0) for a in j.get("apps", {}).values())
        out["days"].append({"date": d, "s": tot})
        for c, a in j.get("apps", {}).items():
            e = out["apps"].setdefault(c, {"class": c, "s": 0, "days": [0] * days, "rss": 0, "rssMax": 0, "title": ""})
            e["s"] += a.get("s", 0)
            e["days"][days - 1 - i] = a.get("s", 0)
            if a.get("rss"):
                e["rss"] = max(e["rss"], a["rss"]) if not e["rss"] else round((e["rss"] + a["rss"]) / 2)
            e["rssMax"] = max(e["rssMax"], a.get("rssMax", 0))
            e["title"] = a.get("title") or e["title"]
        if i == 0:
            out["today"] = {c: a.get("s", 0) for c, a in j.get("apps", {}).items()}
            for h, row in enumerate(j.get("hours", [])[:24]):
                out["hours"][h] = sum(row.values())
                out["hoursApps"][h] = row
    for c, e in out["apps"].items():
        hit = idx.get(c.lower()) or idx.get(c.split(".")[-1].lower())
        if c.startswith("latte:") or (c == "org.quickshell" and e["title"]):
            t = c[6:] if c.startswith("latte:") else e["title"].replace(" — LatteOS", "")
            hit = next((v for v in idx.values() if v[0].startswith("latteos-") and v[1] == t), None) or ("", t, "")
        e["desktop"], e["name"], e["icon"] = (hit or ("", c, ""))
        e["today"] = out["today"].get(c, 0)
    out["apps"] = sorted(out["apps"].values(), key=lambda e: -e["s"])
    out["total"] = sum(d["s"] for d in out["days"])
    return out


FUN_APPS = {"com.discordapp.discord", "discord", "steam", "com.valvesoftware.steam", "spotify", "com.spotify.client", "vlc", "org.videolan.vlc"}


def pohoda_category(c, idx, over):
    """práca / zábava / neutrálne — rovnaké pravidlá ako pohoda.qml (Pulse: Focus vs Leisure)."""
    if c in over:
        return over[c]
    if c == "latte:Heidelberg":
        return "praca"
    if c.startswith("latte:"):
        return "neutral"
    if c.lower() in FUN_APPS:
        return "zabava"
    hit = idx.get(c.lower()) or idx.get(c.split(".")[-1].lower())
    cs = set((hit[3] if hit and len(hit) > 3 else "").split(";"))
    if cs & {"Game", "AudioVideo", "Video", "Audio", "Player", "Music"}:
        return "zabava"
    if cs & {"Development", "Office", "Education", "Science", "Engineering", "IDE", "TextEditor", "WordProcessor", "Spreadsheet"}:
        return "praca"
    return "neutral"


def pohoda_day(date_s, only=None):
    import datetime
    base = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "latteos", "pohoda")
    idx = desktop_index()
    target = datetime.date.fromisoformat(date_s)
    cache = {}

    def load(d):
        k = d.isoformat()
        if k not in cache:
            try:
                cache[k] = json.load(open(os.path.join(base, k + ".json")))
            except (OSError, ValueError):
                cache[k] = {"apps": {}, "hours": [], "halves": []}
        return cache[k]

    def secs(d, c=None):
        j = load(d)
        if c:
            return j["apps"].get(c, {}).get("s", 0)
        return sum(a.get("s", 0) for a in j["apps"].values())

    def ident(c, title=""):
        if c.startswith("latte:"):
            t = c[6:]
            hit = next((v for v in idx.values() if v[0].startswith("latteos-") and v[1] == t), None) or ("", t, "")
        else:
            hit = idx.get(c.lower()) or idx.get(c.split(".")[-1].lower()) or ("", c, "")
        return {"class": c, "desktop": hit[0], "name": hit[1], "icon": hit[2]}

    dn = ["po", "ut", "st", "št", "pi", "so", "ne"]
    monday = target - datetime.timedelta(days=target.weekday())
    week_days = [monday + datetime.timedelta(days=i) for i in range(7)]
    week = [{"date": d.isoformat(), "day": dn[i], "total": secs(d, only), "isTarget": d == target} for i, d in enumerate(week_days)]
    past = [w["total"] for w in week if datetime.date.fromisoformat(w["date"]) <= target and w["total"] > 0]
    first = target.replace(day=1)
    nxt = (first.replace(day=28) + datetime.timedelta(days=4)).replace(day=1)
    month = [{"date": "", "total": -1, "isTarget": False}] * first.weekday()
    d = first
    while d < nxt:
        month.append({"date": d.isoformat(), "total": secs(d, only) if d <= datetime.date.today() else 0, "isTarget": d == target})
        d += datetime.timedelta(days=1)
    j = load(target)
    total = secs(target, only)
    apps = []
    for c, a in sorted(j["apps"].items(), key=lambda kv: -kv[1].get("s", 0)):
        if a.get("s", 0) <= 0:
            continue
        e = ident(c, a.get("title", ""))
        e.update(seconds=a["s"], percent=round(100 * a["s"] / max(1, sum(x.get("s", 0) for x in j["apps"].values()))), rss=a.get("rss", 0))
        apps.append(e)
    halves = [0] * 48
    for i, row in enumerate((j.get("halves") or [])[:48]):
        halves[i] = row.get(only, 0) if only else sum(row.values())
    if not any(halves):                      # staré záznamy iba po hodinách → rozdeliť na polovice
        for h, row in enumerate((j.get("hours") or [])[:24]):
            v = row.get(only, 0) if only else sum(row.values())
            halves[2 * h] = halves[2 * h + 1] = v / 2
    heat, hour_sum = [], [0] * 24
    wapps = {}
    for wd in week_days:
        jj = load(wd)
        row = [0] * 24
        for h, r in enumerate((jj.get("hours") or [])[:24]):
            row[h] = r.get(only, 0) if only else sum(r.values())
            hour_sum[h] += row[h]
        heat.append(row)
        for c, a in jj["apps"].items():
            wapps[c] = wapps.get(c, 0) + a.get("s", 0)
    peak = ""
    best = max(range(23), key=lambda h: hour_sum[h] + hour_sum[h + 1]) if any(hour_sum) else -1
    if best >= 0:
        peak = "%02d:00 – %02d:00" % (best, best + 2)
    wtot = max(1, sum(wapps.values()))
    week_apps = []
    for c, sec in sorted(wapps.items(), key=lambda kv: -kv[1]):
        e = ident(c)
        e.update(seconds=sec, percent=round(100 * sec / wtot))
        week_apps.append(e)
    prev = target - datetime.timedelta(days=1)
    # ── Pulse: čas pred obrazovkou, sústredenie, sluch, kategórie, cieľ ──
    cfgd = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "latteos")
    try:
        over = json.load(open(os.path.join(cfgd, "pohoda-kategorie.json")))
    except (OSError, ValueError):
        over = {}
    try:
        goal = int(read(os.path.join(cfgd, "pohoda-ciel")) or 0)
    except ValueError:
        goal = 0
    scr = [x for x in (j.get("screen") or []) if len(x) == 2]
    screen_total = sum(b - a for a, b in scr)
    sessions = []                                       # úseky spojené, ak je prestávka < 5 min
    for a_, b_ in scr:
        if sessions and a_ - sessions[-1][1] < 300:
            sessions[-1][1] = b_
        else:
            sessions.append([a_, b_])
    breaks = max(0, len(sessions) - 1)
    stretch = j.get("stretch") or {"n": 0, "sum": 0, "longest": 0}
    hearing = j.get("hearing") or {"listen": 0, "loud": 0, "loudHalves": [0] * 48}

    def cat_split(jj):
        out = {"praca": 0, "zabava": 0, "neutral": 0}
        for c, a2 in jj["apps"].items():
            out[pohoda_category(c, idx, over)] += a2.get("s", 0)
        return out
    for e in apps:
        e["category"] = pohoda_category(e["class"], idx, over)
    week_cats = {"praca": 0, "zabava": 0, "neutral": 0}
    week_focus = []
    for wd in week_days:
        jj = load(wd)
        for k2, v2 in cat_split(jj).items():
            week_cats[k2] += v2
        week_focus += [dict(f, date=wd.isoformat()) for f in (jj.get("focus") or [])]
    for e in week_apps:
        e["category"] = pohoda_category(e["class"], idx, over)
    pulse = {"screenTotal": screen_total, "screen": scr, "sessions": len(sessions),
             "longestSession": max((b_ - a_ for a_, b_ in sessions), default=0), "breaks": breaks,
             "switches": j.get("switches", 0), "stretchN": stretch.get("n", 0), "stretchLongest": stretch.get("longest", 0),
             "stretchAvg": round(stretch["sum"] / stretch["n"]) if stretch.get("n") else 0,
             "hearing": hearing, "focus": j.get("focus") or [], "weekFocus": week_focus,
             "categories": cat_split(j), "weekCategories": week_cats, "goal": goal,
             "weekTotal": sum(w["total"] for w in week), "prevWeekTotal": sum(secs(d2 - datetime.timedelta(days=7), only) for d2 in week_days)}
    return {"date": target.isoformat(), "isToday": target == datetime.date.today(), "total": total, "pulse": pulse,
            "average": round(sum(past) / len(past)) if past else 0, "yesterday": secs(prev, only),
            "weekRange": "%d. %d. – %d. %d." % (monday.day, monday.month, week_days[-1].day, week_days[-1].month),
            "week": week, "month": month, "monthName": ["január", "február", "marec", "apríl", "máj", "jún", "júl", "august", "september", "október", "november", "december"][target.month - 1],
            "apps": apps, "hourly": halves, "weekHeatmap": heat, "peak": peak, "weekApps": week_apps,
            "app": ident(only) if only else None}


def main(a):
    cmd = a[0] if a else "once"
    state = {}
    if cmd == "autorun":
        items = desktop_entries() + session_items() + systemd_units(True) + systemd_units(False) + cron() + login_scripts() + kernel_modules()
        for x in items:
            x["missing"] = bool(x.get("command")) and x["kind"] in ("autostart", "session", "cron") and not exists_cmd(x["command"] if x["kind"] != "cron" else " ".join(x["command"].split()[5:]))
        print(json.dumps(items, ensure_ascii=False))
        return 0
    if cmd == "zvuk":
        def pj(*args):
            try:
                return json.loads(subprocess.run(["pactl", "-f", "json"] + list(args), capture_output=True, text=True, timeout=2).stdout or "[]")
            except Exception:
                return []
        info = pj("info")
        default = info.get("default_sink_name", "") if isinstance(info, dict) else ""
        sinks = pj("list", "sinks")
        sink = next((x for x in sinks if x.get("name") == default), sinks[0] if sinks else {})
        vols = [int(str(v.get("value_percent", "0")).rstrip("%") or 0) for v in (sink.get("volume") or {}).values()]
        port = (sink.get("active_port") or "").lower()
        head = int("headphone" in port or "headset" in port or "bluez" in (sink.get("name") or "") or "hdmi" in port and False)
        playing = int(any(not x.get("corked") and x.get("sink") == sink.get("index") for x in pj("list", "sink-inputs")))
        print(playing, max(vols) if vols else 0, head, int(bool(sink.get("mute"))))
        return 0
    if cmd == "sukromie":
        wins = window_pids()
        procs, _ = processes({}, 0, 0, wins)
        devs = device_use(procs)
        names = app_names({x["app"] for x in procs if x["app"]})
        by = {x["pid"]: x for x in procs}
        seen = set()
        for k, ds in devs.items():
            for d in ds & {"mic", "camera"}:
                if isinstance(k, str):
                    who = names.get(k[4:], k[4:])
                else:
                    x = by.get(k, {})
                    who = names.get(x.get("app"), "") or x.get("name", "?")
                if (d, who) not in seen:
                    seen.add((d, who)); print(d + "\t" + who)
        return 0
    if cmd == "rss" and len(a) == 2 and a[1].isdigit():
        print(tree_rss(int(a[1])))
        return 0
    if cmd == "pohoda-den" and len(a) >= 2:
        print(json.dumps(pohoda_day(a[1], a[2] if len(a) > 2 else None), ensure_ascii=False))
        return 0
    if cmd == "pohoda":
        print(json.dumps(pohoda(int(a[1]) if len(a) > 1 and a[1].isdigit() else 7), ensure_ascii=False))
        return 0
    if cmd == "hw-root":
        print(json.dumps(hardware_root(), ensure_ascii=False))
        return 0
    if cmd == "senzory":
        st = {}
        sensors_all(st)
        time.sleep(0.5)
        print(json.dumps(sensors_all(st), ensure_ascii=False))
        return 0
    if cmd == "hw":
        print(json.dumps(hardware(), ensure_ascii=False))
        return 0
    if cmd == "once":
        snapshot(state, False)
        time.sleep(0.3)
        print(json.dumps(snapshot(state, False), ensure_ascii=False))
        return 0
    if cmd == "stream":
        every = float(a[1]) if len(a) > 1 else 1.0
        os.makedirs(RUN, exist_ok=True)
        state["withSensors"] = "senzory" in a[2:]
        snapshot(state)
        while True:
            time.sleep(every)
            snap = snapshot(state)
            try:
                sys.stdout.write(json.dumps(snap, ensure_ascii=False) + "\n")
                sys.stdout.flush()
            except BrokenPipeError:
                return 0
            tele = {k: v for k, v in snap.items() if k != "procs"}
            tmp = os.path.join(RUN, "telemetry.json.tmp")
            with open(tmp, "w") as f:
                json.dump(tele, f)
            os.replace(tmp, os.path.join(RUN, "telemetry.json"))
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(0)
