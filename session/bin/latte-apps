    "pulseaudio": ("Zvuk", "Prehrávať zvuk a nahrávať z mikrofónu", 1, False),
    "cups": ("Zariadenia", "Tlačiť", 0, False), "pcsc": ("Zariadenia", "Čipové karty (občiansky preukaz)", 1, False),
    "ssh-auth": ("Tajomstvá", "Používať tvoje SSH kľúče", 2, False), "gpg-agent": ("Tajomstvá", "Používať tvoje GPG kľúče", 2, False),
    "session-bus": ("Systém", "Celá zbernica relácie — ovládať ostatné aplikácie", 2, False),
    "system-bus": ("Systém", "Celá systémová zbernica", 2, False),
}
PLAN_DEVICES = {
    "dri": ("Zariadenia", "Grafická karta (zrýchlené vykresľovanie)", 0), "all": ("Zariadenia", "Všetky zariadenia — kamera, USB, ovládače", 2),
    "input": ("Zariadenia", "Herné ovládače a vstupné zariadenia", 1), "usb": ("Zariadenia", "Zariadenia USB", 1),
