#!/usr/bin/python3
"""latte-siet — FTP/SFTP, SMB (zdieľané priečinky Windows) a WebDAV servery ako priečinky v Súboroch, cez rclone mount.

  latte-siet pripoj URL [--heslo-stdin]   sftp://pouzivatel@server[:port][/cesta] | ftp://… | ftps://…
                                          smb://pouzivatel@server/zdielanie[/cesta]   (Windows, NAS, Samba)
                                          dav://… | davs://server[:port]/cesta         (WebDAV, Nextcloud; davs = https)
                                          pripojí do ~/Siet/<pouzivatel@server>, vypíše cestu priečinka
  latte-siet odpoj PRIEČINOK              odpojí (fusermount3 -u)
  latte-siet zoznam                       pripojené servery: priečinok<TAB>URL

Heslo sa nikdy nedáva do argumentov (vidno by ho bolo v zozname procesov): ide cez stdin, rclone ho dostane
zašifrované (rclone obscure) v premennej prostredia a nikam sa neukladá. SFTP bez hesla použije kľúče
z ~/.ssh a ssh-agenta. Pri odhlásení sa pripojenia ukončia (rclone beží v relácii).
"""
import os, re, subprocess, sys, time, urllib.parse

HOME = os.path.expanduser("~")
BASE = os.path.join(HOME, "Siet")
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "latte-siet")


def parse(url):
    u = urllib.parse.urlparse(url.strip())
    if u.scheme not in ("sftp", "ftp", "ftps", "smb", "dav", "davs", "webdav", "webdavs") or not u.hostname:
        raise ValueError("adresa musí byť sftp://, ftp://, ftps://, smb://, dav:// alebo davs:// so serverom, napr. smb://jana@nas.local/Dokumenty")
    if not re.fullmatch(r"[A-Za-z0-9.\-:\[\]]+", u.hostname):
        raise ValueError("neplatný názov servera")
    user = urllib.parse.unquote(u.username or "")
    if user and not re.fullmatch(r"[A-Za-z0-9._@\-]+", user):
        raise ValueError("neplatné meno používateľa")
    return u.scheme, user, u.hostname, u.port, urllib.parse.unquote(u.path or "/")


def mounted():
    out = {}
    try:
        for line in open("/proc/self/mounts", encoding="utf-8"):
            f = line.split()
            if len(f) > 2 and f[1].startswith(BASE + "/") and f[2].startswith("fuse.rclone"):
                mp = f[1].encode().decode("unicode_escape")
                try:
                    out[mp] = open(os.path.join(STATE, os.path.basename(mp)), encoding="utf-8").read().strip()
                except OSError:
                    out[mp] = ""
    except OSError:
        pass
    return out


def connect(url, password):
    scheme, user, host, port, path = parse(url)
    name = (user + "@" if user else "") + host
    mp = os.path.join(BASE, name)
    if mp in mounted():
        return mp
    os.makedirs(mp, exist_ok=True)
    env = dict(os.environ)
    backend = {"sftp": "sftp", "smb": "smb", "dav": "webdav", "davs": "webdav", "webdav": "webdav", "webdavs": "webdav"}.get(scheme, "ftp")
    opts = ["host=" + host] if backend != "webdav" else []
    if user:
        opts.append("user=" + user)
    if port and backend != "webdav":
        opts.append("port=%d" % port)
    if backend == "webdav":                     # celá adresa servera ide do url, cesta sa pripojí k nej
        web = "%s://%s%s%s" % ("https" if scheme in ("davs", "webdavs") else "http", host, (":%d" % port) if port else "", path.rstrip("/"))
        opts.append('url="%s"' % web.replace('"', ""))
        opts.append("vendor=other")
        path = "/"
    if backend == "smb":                        # prvá časť cesty je názov zdieľania (rclone: share/cesta)
        path = path.lstrip("/")
    if scheme == "ftps":
        opts.append("explicit_tls=true")
    if password:
        ob = subprocess.run(["rclone", "obscure", "-"], input=password, capture_output=True, text=True, check=True).stdout.strip()
        env["RCLONE_%s_PASS" % backend.upper()] = ob
    elif backend == "sftp":
        for k in ("id_ed25519", "id_ecdsa", "id_rsa"):
            if os.path.exists(os.path.join(HOME, ".ssh", k)):
                opts.append("key_file=" + os.path.join(HOME, ".ssh", k))
                break
        if os.environ.get("SSH_AUTH_SOCK"):
            opts.append("key_use_agent=true")
    remote = ":" + backend + "," + ",".join(o for o in opts if o) + ":" + path
    log = os.path.join(STATE, name + ".log")
    os.makedirs(STATE, exist_ok=True)
    p = subprocess.Popen(["rclone", "mount", remote, mp, "--vfs-cache-mode", "writes", "--dir-cache-time", "30s",
                          "--log-file", log, "--log-level", "NOTICE"],
                         env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(60):
        time.sleep(0.25)
        if mp in mounted():
            with open(os.path.join(STATE, name), "w", encoding="utf-8") as f:
                f.write(url.split("@")[-1] if not user else "%s://%s@%s%s" % (scheme, user, host, (":%d" % port) if port else ""))
            return mp
        if p.poll() is not None:
            break
    p.kill() if p.poll() is None else None
    try:
        os.rmdir(mp)
    except OSError:
        pass
    msg = ""
    try:
        msg = open(log, encoding="utf-8").read().strip().splitlines()[-1]
    except (OSError, IndexError):
        pass
    raise RuntimeError("pripojenie zlyhalo" + (": " + re.sub(r"^\S+ \S+ \w+\s*:\s*", "", msg) if msg else ""))


def disconnect(mp):
    mp = os.path.abspath(mp)
    if not mp.startswith(BASE + "/"):
        raise ValueError("odpojiť sa dá iba priečinok v ~/Siet")
    subprocess.run(["fusermount3", "-u", mp], check=True)
    try:
        os.rmdir(mp)
        os.remove(os.path.join(STATE, os.path.basename(mp)))
    except OSError:
        pass


def main(a):
    try:
        if len(a) >= 2 and a[0] == "pripoj":
            pw = sys.stdin.readline().rstrip("\n") if "--heslo-stdin" in a[2:] else ""
            print(connect(a[1], pw))
            return 0
        if len(a) == 2 and a[0] == "odpoj":
            disconnect(a[1])
            return 0
        if a[:1] == ["zoznam"]:
            for mp, url in sorted(mounted().items()):
                print(mp + "\t" + url)
            return 0
    except (ValueError, RuntimeError, subprocess.CalledProcessError) as e:
        print("latte-siet: " + str(e), file=sys.stderr)
        return 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
