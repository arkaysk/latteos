#!/usr/bin/python3
"""latte-riadok — obsah pre riadok spúšťača Kvapiek (logika pleamaru nevie čítať súbory ani sieť).
Všetko vracia riadky s tabulátormi, aby ich spúšťač ukázal ako klikateľné výsledky (myš prvá, klávesy doplnok).

  latte-riadok akcie DESKTOP_ID          akcie aplikácie z .desktop (Nové okno, Súkromné okno…): meno<TAB>príkaz
  latte-riadok nastavenia DOTAZ          stránky Nastavení podľa slov („wifi“ → Sieť): meno<TAB>oblasť<TAB>stránka
  latte-riadok pocitaj VÝRAZ             kalkulačka a prevody: „15% z 230“, „2^10“, „5 eur v czk“, „10 km v mil“
                                         → výsledok<TAB>popis (nič, ak to nie je výpočet)
  latte-riadok navrhy SLUŽBA DOTAZ       návrhy vyhľadávača počas písania (google | duckduckgo | bing | …), po riadkoch
  latte-riadok dopln TEXT                dopĺňanie posledného slova príkazu: príkazy a cesty, po riadkoch
  latte-riadok vystup PRÍKAZ             krátky výstup bezpečného príkazu (df, free, ip a…) priamo v spúšťači;
                                         iné príkazy: kód 3 (spustiť v termináli)
  latte-riadok zaznam DESKTOP_ID         zapamätá spustenie (hodina, deň v týždni)
  latte-riadok caste [N]                 najčastejšie aplikácie pre túto dennú dobu a deň (id po riadkoch)
"""
import json, math, os, re, shlex, subprocess, sys, time, unicodedata, urllib.parse, urllib.request

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "latteos")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", HOME + "/.cache"), "latteos")


def fold(s):
    return "".join(c for c in unicodedata.normalize("NFKD", s.lower()) if not unicodedata.combining(c))


# ── akcie aplikácie ──────────────────────────────────────────────────────────────────────────
def desktop_dirs():
    xdg = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    return [HOME + "/.local/share/applications", HOME + "/.local/share/flatpak/exports/share/applications",
            "/var/lib/flatpak/exports/share/applications"] + [d + "/applications" for d in xdg]


def akcie(did):
    did = did if did.endswith(".desktop") else did + ".desktop"
    for d in desktop_dirs():
        p = os.path.join(d, did)
        if not os.path.exists(p):
            continue
        sec, names, execs, lang = None, {}, {}, (os.environ.get("LANG", "sk")[:2])
        for line in open(p, encoding="utf-8", errors="replace"):
            line = line.strip()
            m = re.match(r"^\[Desktop Action (.+)\]$", line)
            if m:
                sec = m.group(1); continue
            if line.startswith("["):
                sec = None; continue
            if sec and "=" in line:
                k, v = line.split("=", 1)
                if k == "Name" or (k == "Name[%s]" % lang):
                    if k != "Name" or sec not in names:
                        names[sec] = v
                elif k == "Exec":
                    execs[sec] = re.sub(r"\s*%[fFuUdDnNickvm]", "", v)
        for s, n in names.items():
            if s in execs:
                print("%s\t%s" % (n, execs[s]))
        return


# ── stránky Nastavení ────────────────────────────────────────────────────────────────────────
SETTINGS = [  # (oblasť, stránka, meno, kľúčové slová)
    ("hardver", "siet", "Sieť", "wifi wi-fi internet ethernet kabel vpn ip proxy siet"),
    ("hardver", "bluetooth", "Bluetooth a periférie", "bluetooth sluchadla reproduktor ovladac gamepad sparovat"),
