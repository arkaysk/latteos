#!/usr/bin/python3
"""latte-nove-okno TRIEDA — nové okno aplikácie podľa triedy okna (stredný klik na okno na lište, ako Windows).
Nájde .desktop súbor (StartupWMClass, meno súboru alebo posledná časť ID) a spustí ho cez gtk-launch."""
import glob, os, subprocess, sys

cls = (sys.argv[1] if len(sys.argv) > 1 else "").strip()
if not cls:
    sys.exit(2)
home = os.path.expanduser("~")
dirs = [os.path.join(os.environ.get("XDG_DATA_HOME", home + "/.local/share"), "applications"),
        home + "/.local/share/flatpak/exports/share/applications", "/var/lib/flatpak/exports/share/applications",
        "/usr/local/share/applications", "/usr/share/applications"]
low = cls.lower()
best = None
for d in dirs:
    for f in sorted(glob.glob(d + "/*.desktop")):
        did = os.path.basename(f)[:-8]
        wm = ""
        try:
            for line in open(f, encoding="utf-8", errors="ignore"):
                if line.startswith("StartupWMClass="):
                    wm = line.split("=", 1)[1].strip()
                    break
        except OSError:
            continue
        if wm.lower() == low:
            best = did
            break
        if best is None and (did.lower() == low or did.lower().split(".")[-1] == low.split(".")[-1]):
            best = did
    if best and best.lower() != low.split(".")[-1]:
        break
if best:
    subprocess.Popen(["gtk-launch", best], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
else:
    subprocess.Popen([low], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
