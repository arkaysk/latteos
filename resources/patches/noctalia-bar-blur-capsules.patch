@@ -2415,6 +2415,10 @@ void Bar::createInstance(const WaylandOutput& output, std::size_t barIndex, cons
   });
   instance->surface->setPrepareFrameCallback([this, inst](bool needsUpdate, bool needsLayout) {
     prepareFrame(*inst, needsUpdate, needsLayout);
+    // capsules move and resize with their content: keep the capsule-only blur region in sync
+    if (needsLayout && inst->barConfig.backgroundOpacity <= 0.01F) {
